{% doc %}
  Reusable media block for rendering an image via the shared image snippet.
  If a product is available, the media block can use the product image fallback.
{% enddoc %}

{% assign image_ratio = block.settings.image_ratio | default: 'adapt' %}
{% assign hover_secondary = block.settings.hover_secondary | default: false %}
{% assign img_w = block.settings.width | default: 800 %}
{% assign img_h = block.settings.height | default: '' %}
{% assign has_secondary = false %}
{% assign image_source = block.settings.image %}

{% if image_ratio == 'square' %}
  {% assign img_h = img_w %}
{% elsif image_ratio == 'landscape' %}
  {% assign img_h = img_w | times: 9 | divided_by: 16 %}
{% elsif image_ratio == 'portrait' %}
  {% assign img_h = img_w | times: 4 | divided_by: 3 %}
{% endif %}

{% if image_source == blank and product and product.featured_image %}
  {% if block.settings.use_secondary_image and product.images.size > 1 %}
    {% assign image_source = product.images[1] %}
  {% else %}
    {% assign image_source = product.featured_image %}
  {% endif %}
{% endif %}

{% if hover_secondary and product and product.images.size > 1 %}
  {% assign has_secondary = true %}
{% endif %}

<div class="media-block {{ block.settings.media_class }}" {{ block.shopify_attributes }}>
  {% if img_h != '' %}
    {% render 'image', image: image_source, class: block.settings.image_class | default: 'product-image primary', width: img_w, height: img_h, crop: block.settings.crop | default: 'center' %}
  {% else %}
    {% render 'image', image: image_source, class: block.settings.image_class | default: 'product-image primary', width: img_w, crop: block.settings.crop | default: 'center' %}
  {% endif %}

  {% if has_secondary and block.settings.show_secondary %}
    {% if img_h != '' %}
      {% render 'image', image: product.images[1], class: block.settings.secondary_class | default: 'product-image secondary', width: img_w, height: img_h, crop: block.settings.crop | default: 'center' %}
    {% else %}
      {% render 'image', image: product.images[1], class: block.settings.secondary_class | default: 'product-image secondary', width: img_w, crop: block.settings.crop | default: 'center' %}
    {% endif %}
  {% endif %}
</div>

{% schema %}
{
  "name": "Media",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom image"
    },
    {
      "type": "checkbox",
      "id": "use_secondary_image",
      "label": "Use secondary product image",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_secondary",
      "label": "Show secondary image",
      "default": false
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "inherit",
      "options": [
        { "value": "inherit", "label": "Inherit from parent" },
        { "value": "adapt", "label": "Adapt" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "portrait", "label": "Portrait" }
      ]
    },
    {
      "type": "text",
      "id": "image_class",
      "label": "Image class",
      "default": "product-image primary"
    },
    {
      "type": "text",
      "id": "secondary_class",
      "label": "Secondary image class",
      "default": "product-image secondary"
    },
    {
      "type": "text",
      "id": "media_class",
      "label": "Media wrapper class"
    },
    {
      "type": "select",
      "id": "crop",
      "label": "Crop",
      "default": "center",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media"
    }
  ]
}
{% endschema %}
