{% doc %}
  Reusable media block for rendering an image via the shared image snippet.
  Supports:
  - custom uploaded image
  - product featured image fallback
  - optional secondary image
  - CSS aspect-ratio system
{% enddoc %}

{% assign image_ratio = block.settings.image_ratio | default: 'adapt' %}
{% assign show_secondary = block.settings.show_secondary | default: false %}
{% assign has_secondary = false %}
{% assign image_source = block.settings.image %}

{% assign product = closest.product | default: product %}

{% if image_source == blank and product and product.featured_image %}
  {% if block.settings.use_secondary_image and product.images.size > 1 %}
    {% assign image_source = product.images[1] %}
  {% else %}
    {% assign image_source = product.featured_image %}
  {% endif %}
{% endif %}

{% if show_secondary and product and product.images.size > 1 %}
  {% assign has_secondary = true %}
{% endif %}

<div
  class="
    media-block
    media-block--{{ image_ratio }}
    {% if has_secondary %}has-secondary{% endif %}
    {{ block.settings.media_class }}
  "
  {{ block.shopify_attributes }}
>
  {%
    render 'image',
    image: image_source,
    class: block.settings.image_class | default: 'product-image primary',
    width: img_w,
    crop: block.settings.crop | default: 'center'
  %}

  {% if has_secondary %}
    {%
      render 'image',
      image: product.images[1],
      class: block.settings.secondary_class | default: 'product-image secondary',
      width: img_w,
      crop: block.settings.crop | default: 'center'
    %}
  {% endif %}
</div>

{% stylesheet %}
  .media-block {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .media-block .image {
    width: 100%;
    height: 100%;
  }

  .media-block img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  /* Aspect Ratios */
  .media-block--square .image {
    aspect-ratio: 1 / 1;
  }

  .media-block--landscape .image {
    aspect-ratio: 4 / 2;
  }

  .media-block--portrait .image {
    aspect-ratio: 3 / 4;
  }

  .media-block--adapt .image,
  .media-block--inherit .image {
    aspect-ratio: auto;
  }

  /* Secondary Image Hover */
  .media-block.has-secondary {
    position: relative;
  }

  .media-block .secondary {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .media-block.has-secondary:hover .secondary {
    opacity: 1;
  }

  .media-block.has-secondary:hover .primary {
    opacity: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.media.media",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:blocks.media.image_custom_image"
    },
    {
      "type": "checkbox",
      "id": "use_secondary_image",
      "label": "t:blocks.media.use_secondary_image_use_secondary_product_image",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_secondary",
      "label": "t:blocks.media.show_secondary_show_secondary_image",
      "default": false
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:blocks.media.image_ratio_image_ratio",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "t:blocks.media.image_ratio_inherit_from_parent"
        },
        {
          "value": "adapt",
          "label": "t:blocks.media.image_ratio_adapt"
        },
        {
          "value": "square",
          "label": "t:blocks.media.image_ratio_square"
        },
        {
          "value": "landscape",
          "label": "t:blocks.media.image_ratio_landscape"
        },
        {
          "value": "portrait",
          "label": "t:blocks.media.image_ratio_portrait"
        }
      ]
    },
    {
      "type": "text",
      "id": "image_class",
      "label": "t:blocks.media.image_class_image_class",
      "default": "product-image primary"
    },
    {
      "type": "text",
      "id": "secondary_class",
      "label": "t:blocks.media.secondary_class_secondary_image_class",
      "default": "product-image secondary"
    },
    {
      "type": "text",
      "id": "media_class",
      "label": "t:blocks.media.media_class_media_wrapper_class"
    },
    {
      "type": "select",
      "id": "crop",
      "label": "t:blocks.media.crop_crop",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "t:blocks.media.crop_center"
        },
        {
          "value": "top",
          "label": "t:blocks.media.crop_top"
        },
        {
          "value": "bottom",
          "label": "t:blocks.media.crop_bottom"
        },
        {
          "value": "left",
          "label": "t:blocks.media.crop_left"
        },
        {
          "value": "right",
          "label": "t:blocks.media.crop_right"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:blocks.media.media"
    }
  ],
  "tag": null
}
{% endschema %}
