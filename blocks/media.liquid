{% doc %}
  Reusable media block for rendering an image via the shared image snippet.
  Supports:
  - custom uploaded image
  - product featured image fallback
  - optional secondary image
  - CSS aspect-ratio system
{% enddoc %}

{% assign image_ratio = block.settings.image_ratio | default: 'adapt' %}
{% assign show_secondary = block.settings.show_secondary | default: false %}
{% assign has_secondary = false %}
{% assign image_source = block.settings.image %}

{% assign product = closest.product | default: product %}

{% if image_source == blank and product and product.featured_image %}
  {% if block.settings.use_secondary_image and product.images.size > 1 %}
    {% assign image_source = product.images[1] %}
  {% else %}
    {% assign image_source = product.featured_image %}
  {% endif %}
{% endif %}

{% if show_secondary and product and product.images.size > 1 %}
  {% assign has_secondary = true %}
{% endif %}

<div
  class="
    media-block
    media-block--{{ image_ratio }}
    {% if has_secondary %}has-secondary{% endif %}
    {{ block.settings.media_class }}
  "
  {{ block.shopify_attributes }}
>
  {%
    render 'image',
    image: image_source,
    class: block.settings.image_class | default: 'product-image primary',
    width: img_w,
    crop: block.settings.crop | default: 'center'
  %}

  {% if has_secondary %}
    {%
      render 'image',
      image: product.images[1],
      class: block.settings.secondary_class | default: 'product-image secondary',
      width: img_w,
      crop: block.settings.crop | default: 'center'
    %}
  {% endif %}
</div>

{% stylesheet %}
  .media-block {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .media-block .image {
    width: 100%;
    height: 100%;
  }

  .media-block img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  /* Aspect Ratios */
  .media-block--square .image {
    aspect-ratio: 1 / 1;
  }

  .media-block--landscape .image {
    aspect-ratio: 4 / 2;
  }

  .media-block--portrait .image {
    aspect-ratio: 3 / 4;
  }

  .media-block--adapt .image,
  .media-block--inherit .image {
    aspect-ratio: auto;
  }

  /* Secondary Image Hover */
  .media-block.has-secondary {
    position: relative;
  }

  .media-block .secondary {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .media-block.has-secondary:hover .secondary {
    opacity: 1;
  }

  .media-block.has-secondary:hover .primary {
    opacity: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Media",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom image"
    },
    {
      "type": "checkbox",
      "id": "use_secondary_image",
      "label": "Use secondary product image",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_secondary",
      "label": "Show secondary image",
      "default": false
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "inherit",
      "options": [
        { "value": "inherit", "label": "Inherit from parent" },
        { "value": "adapt", "label": "Adapt" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "portrait", "label": "Portrait" }
      ]
    },
    {
      "type": "text",
      "id": "image_class",
      "label": "Image class",
      "default": "product-image primary"
    },
    {
      "type": "text",
      "id": "secondary_class",
      "label": "Secondary image class",
      "default": "product-image secondary"
    },
    {
      "type": "text",
      "id": "media_class",
      "label": "Media wrapper class"
    },
    {
      "type": "select",
      "id": "crop",
      "label": "Crop",
      "default": "center",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media"
    }
  ],
  "tag": null
}
{% endschema %}
