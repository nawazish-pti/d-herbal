

{% capture media_block_output %}
  {%- content_for 'block', type: 'media', id: 'product-media', product: product %}{% endcapture %}

{% capture children %}
  {% content_for 'blocks' %}
{% endcapture %}

{% render 'product-card',
  product: product,
  block: block,
  block_settings: block.settings,
  children: children,
  media_block_output: media_block_output,
  img_ratio: img_ratio,
  img_w: img_w,
  img_h: img_h,
  has_secondary: has_secondary
%}

{% schema %}
{
  "name": "Product Card",
  "settings": [
  ],
  "blocks": [
    { "type": "product-title" },
    { "type": "product-price" },
    { "type": "product-description" },
    { "type": "media" },
    { "type": "product-swatch" },
    { "type": "product-variants" }
  ],
  "presets": [
    {
      "name": "Product Card"
    }
  ]
}
{% endschema %}
