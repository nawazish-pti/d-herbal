{% liquid
  assign product = block.settings.product | default: product
  assign has_secondary = false

  if product.images.size > 1
    assign has_secondary = true
  endif
%}

{% capture media_block_output %}
  {%- content_for 'block', type: 'media', id: 'product-media', product: product %}{% endcapture %}

{% capture children %}
  {% content_for 'blocks',closest.product: product %}
{% endcapture %}

{% render 'product-card',
  product: product,
  children: children,
  media_block_output: media_block_output,
  has_secondary: has_secondary,
  block: block
%}

{% schema %}
{
  "name": "t:blocks.product-card.product_card",
  "settings": [
    {
      "type": "range",
      "id": "content_gap",
      "label": "t:blocks.product-card.content_gap_content_spacing",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16,
      "info": "t:blocks.product-card.content_gap_spacing_between_child_blocks_inside_the_product_card"
    }
  ],
  "blocks": [
    {
      "type": "media"
    },
    {
      "type": "product-title"
    },
    {
      "type": "product-vendor"
    },
    {
      "type": "product-price"
    },
    {
      "type": "product-description"
    },
    {
      "type": "product-swatch"
    },
    {
      "type": "product-variants"
    },
    {
      "type": "buy-buttons"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.product-card.product_card"
    }
  ],
  "tag": null
}
{% endschema %}
