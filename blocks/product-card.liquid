{% liquid
  assign product = block.settings.product | default: product
  assign has_secondary = false

  if product.images.size > 1
    assign has_secondary = true
  endif
%}

{% capture media_block_output %}
  {%- content_for 'block', type: 'media', id: 'product-media', product: product %}{% endcapture %}

{% capture children %}
  {% content_for 'blocks',closest.product: product %}
{% endcapture %}

{% render 'product-card',
  product: product,
  children: children,
  media_block_output: media_block_output,
  has_secondary: has_secondary,
  block: block
%}

{% schema %}
{
  "name": "Product Card",
  "settings": [
    {
      "type": "range",
      "id": "content_gap",
      "label": "Content spacing",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16,
      "info": "Spacing between child blocks inside the product card"
    }
  ],
  "blocks": [
    { "type": "product-title" },
    { "type": "product-price" },
    { "type": "product-description" },
    { "type": "media" },
    { "type": "product-swatch" }
  ],
  "presets": [
    {
      "name": "Product Card"
    }
  ],
  "tag":null
}
{% endschema %}
