{% liquid
  assign img_ratio = block.settings.image_ratio | default: 'adapt'
  assign hover_secondary = block.settings.hover_secondary | default: false
  assign img_w = 800
  assign img_h = ''
  assign has_secondary = false

  if img_ratio == 'square'
    assign img_h = img_w
  elsif img_ratio == 'landscape'
    assign img_h = img_w | times: 9 | divided_by: 16
  elsif img_ratio == 'portrait'
    assign img_h = img_w | times: 4 | divided_by: 3
  endif

  if hover_secondary and product.images.size > 1
    assign has_secondary = true
  endif
%}

<div class="product-card-wrapper" {{ block.shopify_attributes }}>
    {% assign media_image_ratio = img_ratio %}
    {% assign media_hover_secondary = hover_secondary %}
    {% assign media_img_w = img_w %}
    {% assign media_img_h = img_h %}
    {% assign media_product = product %}
  <div class="images_wrapper image--{{ img_ratio }} {% if has_secondary %}has-secondary{% endif %}" data-media-image-ratio="{{ media_image_ratio }}" data-media-hover-secondary="{{ media_hover_secondary }}" data-media-img-w="{{ media_img_w }}" data-media-img-h="{{ media_img_h }}" data-media-product-id="{{ media_product.id }}">

    {% capture media_block_output %}
        {%- content_for 'block', type:"media", id:'product-media', product: product %}{% endcapture %}
    {% if media_block_output != blank %}
      {{ media_block_output }}
    {% endif %}
  </div>

  <div class="product-card__content">
    {% content_for 'blocks', closest.product:product %}
  </div>
</div>

{% schema %}
{
  "name": "Product Card",
  "settings": [
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "adapt",
      "options": [
        { "value": "adapt", "label": "Adapt" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "portrait", "label": "Portrait" }
      ]
    },
    {
      "type": "checkbox",
      "id": "hover_secondary",
      "label": "Show secondary image on hover",
      "default": false
    }
  ],
  "blocks": [
    { "type": "product-title" },
    { "type": "product-price" },
    { "type": "product-vendor" },
    { "type": "product-description" },
    { "type": "media" },
    { "type": "product-badge" },
    { "type": "product-swatch" },
    { "type": "product-variants" }
  ],
  "presets": [
    {
      "name": "Product Card"
    }
  ]
}
{% endschema %}
