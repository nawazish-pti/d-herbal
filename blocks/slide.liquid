<!--slide.liquid---->
<div class="main_slide">
    <div class="image_block_slide">
        {% render 'image', image: block.settings.image, class: 'main_slide_image', width: 1600 %}
    </div>
    <div class="content_wraper_slide">
        <h2>Heading</h2>
        <p>Content</p>
        <a href="" class="button">Button</a>
    </div>
</div>
{% schema %}
{
  "name": "t:blocks.slide.slide",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:blocks.slide.image_image"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.slide.slide"
    }
  ],
  "tag": null
}
{% endschema %}