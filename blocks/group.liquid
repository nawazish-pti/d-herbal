      "step": 1,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:blocks.group.padding_right_padding_right",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 24,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.group.group"
    }
  ],
  "tag": null
}
{% endschema %}
