          "label": "t:blocks.group.width_mobile_custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "width_mobile_custom",
      "label": "t:blocks.group.width_mobile_custom_custom_width",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 90,
      "unit": "%",
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:blocks.group.background"
    },
    {
      "type": "select",
      "id": "select_bg",
      "label": "t:blocks.group.select_bg_background",
      "options": [
        {
          "value": "bg-color",
          "label": "t:blocks.group.select_bg_background_color"
        },
        {
          "value": "bg-image",
          "label": "t:blocks.group.select_bg_image"
        }
      ],
      "default": "bg-color"
    },
    {
      "type": "color",
