      "id": "link_url",
      "label": "t:blocks.group.link_url_url",
      "info": "t:blocks.group.link_url_when_set_the_whole_block_becomes_clickable"
    },
    {
      "type": "header",
      "content": "t:blocks.group.padding"
    },
    {
      "type": "range",
