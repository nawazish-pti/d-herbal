{% doc %}
  Renders a Horizon-style group/container block with nested theme blocks,
  responsive width, layout alignment, background, link and padding controls.

  @example
  {% content_for 'block', type: 'group', id: 'group' %}
{% enddoc %}

{% liquid
  assign layout_direction = block.settings.layout_direction | default: 'column'
  if layout_direction == 'group--horizontal'
    assign layout_direction = 'row'
  elsif layout_direction == 'group--vertical'
    assign layout_direction = 'column'
  endif

  if layout_direction == 'row'
    assign justify = block.settings.horizontal_alignment | default: 'flex-start'
    assign align = block.settings.horizontal_position | default: 'flex-start'
  else
    assign justify = block.settings.vertical_position | default: 'flex-start'
    assign align = block.settings.vertical_alignment | default: 'flex-start'
  endif

  assign width_class = block.settings.width | default: 'fill'
  if width_class == 'fit-content'
    assign width_class = 'fit'
  endif

  assign width_mobile_class = block.settings.width_mobile | default: 'fill'
  if width_mobile_class == 'fit-content'
    assign width_mobile_class = 'fit'
  endif

  assign fill_class = ''
  if block.settings.width == 'fill' or block.settings.height == 'fill'
    assign fill_class = 'group-block--fill'
  endif
%}

<div
  class="
    main_group group group-block {{ fill_class }}
    group-block--width-{{ width_class }}
    group-block--height-{{ block.settings.height }}
    group-block--mobile-width-{{ width_mobile_class }}
    layout_flex_{{ layout_direction }}
  "
  style="
    {% render 'style-size', settings: block.settings %}
    --justify: {{ justify }};
    --align: {{ align }};
    --gap: {{ block.settings.gap }}px;
    --padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px;
    --background-color: {{ block.settings.background_color }};
  "
>
  {% if block.settings.link_url != blank %}
    <a href="{{ block.settings.link_url }}" class="group_container__link" aria-label="Open group link"></a>
  {% endif %}

  <div class="bg_media {% if block.settings.select_bg == 'bg-color' %}bg_color bg_color_{{ block.id }}{% else %}bg_media_img{% endif %}">
    {% if block.settings.select_bg == 'bg-image' and block.settings.bg_image != blank %}
      {% render 'image', image: block.settings.bg_image, class: 'main_slide_image_mobile', width: 1600 %}
    {% endif %}
  </div>

  <div class="container_group container_group_{{ block.id }} group-block-content" {{ block.shopify_attributes }}>
    {% content_for 'blocks' %}
  </div>
</div>

{% style %}
  .main_group,
  .group-block,
  .group-block-content {
    position: relative;
  }

  .main_group {
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    overflow: hidden;
  }

  .group-block--width-fill {
    width: 100%;
  }

  .group-block--width-fit {
    width: fit-content;
  }

  .group-block--width-custom {
    width: var(--size-style-width);
  }

  .group-block--height-fill {
    height: var(--size-style-height);
  }

  .group-block--height-fit {
    height: auto;
  }

  .group-block--height-custom {
    height: var(--size-style-height);
  }

  .container_group {
    z-index: 1;
    display: flex;
    justify-content: var(--justify);
    align-items: var(--align);
    gap: var(--gap);
    width: 100%;
    height: 100%;
    min-width: 0;
    box-sizing: border-box;
    padding: var(--padding);
  }

  .layout_flex_row .container_group_{{ block.id }} {
    flex-direction: row;
  }

  .layout_flex_column .container_group_{{ block.id }} {
    flex-direction: column;
  }

  .container_group > * {
    min-width: 0;
  }

  .bg_media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .bg_color {
    background-color: var(--background-color);
  }

  .bg_media_img .image,
  .bg_media_img .image > img {
    width: 100%;
    height: 100%;
  }

  .bg_media_img .image > img {
    display: block;
    object-fit: cover;
  }

  .group_container__link {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: block;
  }

  .group_container__link ~ .container_group {
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .group-block--mobile-width-fill {
      width: 100%;
    }

    .group-block--mobile-width-fit {
      width: fit-content;
    }

    .group-block--mobile-width-custom {
      width: var(--size-style-width-mobile);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Group",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "select",
      "id": "layout_direction",
      "label": "Layout direction",
      "options": [
        { "value": "row", "label": "Horizontal" },
        { "value": "column", "label": "Vertical" }
      ],
      "default": "row"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "Alignment",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "visible_if": "{{ block.settings.layout_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_position",
      "label": "Position",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.layout_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Alignment",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "visible_if": "{{ block.settings.layout_direction == 'column' }}"
    },
    {
      "type": "select",
      "id": "vertical_position",
      "label": "Position",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" },
        { "value": "space-between", "label": "Space between" }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.layout_direction == 'column' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "fill", "label": "Fill" },
        { "value": "fit-content", "label": "Fit" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "width_custom",
      "label": "Custom width",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "%",
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "fill", "label": "Fill" },
        { "value": "fit", "label": "Fit" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "height_custom",
      "label": "Custom height",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%",
      "visible_if": "{{ block.settings.height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width",
      "options": [
        { "value": "fill", "label": "Fill" },
        { "value": "fit-content", "label": "Fit" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "width_mobile_custom",
      "label": "Custom width",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 90,
      "unit": "%",
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "select_bg",
      "label": "Background",
      "options": [
        { "value": "bg-color", "label": "Background color" },
        { "value": "bg-image", "label": "Image" }
      ],
      "default": "bg-color"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f8f9fa",
      "alpha": true,
      "visible_if": "{{ block.settings.select_bg == 'bg-color' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Image",
      "visible_if": "{{ block.settings.select_bg == 'bg-image' }}"
    },
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "URL",
      "info": "When set, the whole block becomes clickable."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding left",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding right",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 24,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Group"
    }
  ],
  "tag": null
}
{% endschema %}
