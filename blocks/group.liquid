   .main_group,
.group-block {
  position: relative;
  box-sizing: border-box;
  min-width: 0;
  min-height: 0;
  max-width: 100%;
}

/* Width */

.group-block--width-fill {
  width: 100%;
  flex: 1 1 auto;
}

.group-block--width-fit {
  width: fit-content;
  flex: 0 0 auto;
}

.group-block--width-custom {
  width: var(--size-style-width);
  flex: 0 0 auto;
}

/* Height */

.group-block--height-fill {
  height: 100%;
  align-self: stretch;
}

.group-block--height-fit {
  height: auto;
}

.group-block--height-custom {
  height: var(--size-style-height);
}

/* Container */

.container_group {
  position: relative;
  z-index: 1;

  display: flex;
  flex-wrap: nowrap;

  justify-content: var(--justify);
  align-items: var(--align);

  gap: var(--gap);

  box-sizing: border-box;

  min-width: 0;
  min-height: 0;

  padding: var(--padding);
}

/* Direction */

.layout_flex_row > .container_group {
  flex-direction: row;
}

.layout_flex_column > .container_group {
  flex-direction: column;
}

/* Only direct children */

.container_group > * {
  min-width: 0;
  min-height: 0;
  flex-shrink: 1;
}

/* Background */

.bg_media {
  position: absolute;
  inset: 0;
  overflow: hidden;
  z-index: 0;
  pointer-events: none;
}

.bg_color {
  background: var(--background-color);
}

.bg_media_img .image,
.bg_media_img img {
  width: 100%;
  height: 100%;
}

.bg_media_img img {
  display: block;
  object-fit: cover;
}

/* Link */

.group_container__link {
  position: absolute;
  inset: 0;
  z-index: 2;
}

/* Disable only direct content */

.group_container__link + .bg_media + .container_group {
  pointer-events: none;
}

.group_container__link
  + .bg_media
  + .container_group
  > * {
  pointer-events: auto;
}

/* Mobile */

@media (max-width: 749px) {

  .group-block--mobile-width-fill {
    width: 100%;
    flex: 1 1 auto;
  }

  .group-block--mobile-width-fit {
    width: fit-content;
    flex: 0 0 auto;
  }

  .group-block--mobile-width-custom {
    width: var(--size-style-width-mobile);
    flex: 0 0 auto;
  }

}
{% endstyle %}

{% schema %}
{
  "name": "t:blocks.group.group",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "layout_direction",
      "label": "t:blocks.group.layout_direction_layout_direction",
      "options": [
        {
          "value": "row",
          "label": "t:blocks.group.layout_direction_horizontal"
        },
        {
          "value": "column",
          "label": "t:blocks.group.layout_direction_vertical"
        }
      ],
      "default": "row"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:blocks.group.horizontal_alignment_alignment",
      "default": "flex-start",
      "options": [
        {
          "value": "flex-start",
          "label": "t:blocks.group.horizontal_alignment_left"
        },
        {
          "value": "center",
          "label": "t:blocks.group.horizontal_alignment_center"
        },
        {
          "value": "flex-end",
          "label": "t:blocks.group.horizontal_alignment_right"
        }
      ],
      "visible_if": "{{ block.settings.layout_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_position",
      "label": "t:blocks.group.horizontal_position_position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:blocks.group.horizontal_position_top"
        },
        {
          "value": "center",
          "label": "t:blocks.group.horizontal_position_center"
        },
        {
          "value": "flex-end",
          "label": "t:blocks.group.horizontal_position_bottom"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.layout_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:blocks.group.vertical_alignment_alignment",
      "default": "flex-start",
      "options": [
        {
          "value": "flex-start",
          "label": "t:blocks.group.vertical_alignment_left"
        },
        {
          "value": "center",
          "label": "t:blocks.group.vertical_alignment_center"
        },
        {
          "value": "flex-end",
          "label": "t:blocks.group.vertical_alignment_right"
        }
      ],
      "visible_if": "{{ block.settings.layout_direction == 'column' }}"
    },
    {
      "type": "select",
      "id": "vertical_position",
      "label": "t:blocks.group.vertical_position_position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:blocks.group.vertical_position_top"
        },
        {
          "value": "center",
          "label": "t:blocks.group.vertical_position_center"
        },
        {
          "value": "flex-end",
          "label": "t:blocks.group.vertical_position_bottom"
        },
        {
          "value": "space-between",
          "label": "t:blocks.group.vertical_position_space_between"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.layout_direction == 'column' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:blocks.group.gap_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:blocks.group.desktop"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:blocks.group.width_width",
      "options": [
        {
          "value": "fill",
          "label": "t:blocks.group.width_fill"
        },
        {
          "value": "fit-content",
          "label": "t:blocks.group.width_fit"
        },
        {
          "value": "custom",
          "label": "t:blocks.group.width_custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "width_custom",
      "label": "t:blocks.group.width_custom_custom_width",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "%",
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:blocks.group.height_height",
      "options": [
        {
          "value": "fill",
          "label": "t:blocks.group.height_fill"
        },
        {
          "value": "fit",
          "label": "t:blocks.group.height_fit"
        },
        {
          "value": "custom",
          "label": "t:blocks.group.height_custom"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "height_custom",
      "label": "t:blocks.group.height_custom_custom_height",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%",
      "visible_if": "{{ block.settings.height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:blocks.group.mobile"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:blocks.group.width_mobile_width",
      "options": [
        {
          "value": "fill",
          "label": "t:blocks.group.width_mobile_fill"
        },
        {
          "value": "fit-content",
          "label": "t:blocks.group.width_mobile_fit"
        },
        {
