      "default": "#f8f9fa",
      "alpha": true,
      "visible_if": "{{ block.settings.select_bg == 'bg-color' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "t:blocks.group.bg_image_image",
      "visible_if": "{{ block.settings.select_bg == 'bg-image' }}"
    },
    {
      "type": "header",
      "content": "t:blocks.group.link"
    },
    {
