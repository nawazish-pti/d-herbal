{% doc %}
  Renders a Horizon-style group/container block with nested theme blocks,
  responsive width, layout alignment, background, link and padding controls.

  @example
  {% content_for 'block', type: 'group', id: 'group' %}
{% enddoc %}

{% liquid
  assign layout_direction = block.settings.layout_direction | default: 'column'
  if layout_direction == 'group--horizontal'
    assign layout_direction = 'row'
  elsif layout_direction == 'group--vertical'
    assign layout_direction = 'column'
  endif

  if layout_direction == 'row'
    assign justify = block.settings.horizontal_alignment | default: 'flex-start'
    assign align = block.settings.horizontal_position | default: 'flex-start'
  else
    assign justify = block.settings.vertical_position | default: 'flex-start'
    assign align = block.settings.vertical_alignment | default: 'flex-start'
  endif

  assign width_class = block.settings.width | default: 'fill'
  if width_class == 'fit-content'
    assign width_class = 'fit'
  endif

  assign width_mobile_class = block.settings.width_mobile | default: 'fill'
  if width_mobile_class == 'fit-content'
    assign width_mobile_class = 'fit'
  endif

  assign fill_class = ''
  if block.settings.width == 'fill' or block.settings.height == 'fill'
    assign fill_class = 'group-block--fill'
  endif
%}

<div
  class="
    main_group group group-block {{ fill_class }}
    group-block--width-{{ width_class }}
    group-block--height-{{ block.settings.height }}
    group-block--mobile-width-{{ width_mobile_class }}
    layout_flex_{{ layout_direction }}
  "
  style="
    {% render 'style-size', settings: block.settings %}
    --justify: {{ justify }};
    --align: {{ align }};
    --gap: {{ block.settings.gap }}px;
    --padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px;
    --background-color: {{ block.settings.background_color }};
  "
>
  {% if block.settings.link_url != blank %}
    <a href="{{ block.settings.link_url }}" class="group_container__link" aria-label="Open group link"></a>
  {% endif %}

  <div class="bg_media {% if block.settings.select_bg == 'bg-color' %}bg_color bg_color_{{ block.id }}{% else %}bg_media_img{% endif %}">
    {% if block.settings.select_bg == 'bg-image' and block.settings.bg_image != blank %}
      {% render 'image', image: block.settings.bg_image, class: 'main_slide_image_mobile', width: 1600 %}
    {% endif %}
  </div>

  <div class="container_group container_group_{{ block.id }} group-block-content" {{ block.shopify_attributes }}>
    {% content_for 'blocks' %}
  </div>
</div>

