{% doc %}
  Renders a text block.

  {% content_for 'block', type: 'text', id: 'text' %}
{% enddoc %}

{% assign preset_element = block.settings %}
{% assign product_data = closest.product %}
<a href="{{ product_data.url }}" class="product-card-link" aria-label="View {{ product_data.title }}">
  {% render 'text', fallback: product.title, preset_element: preset_element, product_data: product_data %}
</a>
{% stylesheet %}
  .text {
    text-align: var(--text-align);
  }
  .text--title {
    font-size: 2rem;
    font-weight: 700;
  }
  .text--subtitle {
    font-size: 1.5rem;
  }
  .text--normal {
    font-size: 1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.text",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:blocks.product-title.paragraph_displays_title_from_parent_product"
    },
    {
      "type": "select",
      "id": "preset",
      "label": "t:blocks.product-title.preset_preset",
      "default": "rte",
      "options": [
        {
          "value": "rte",
          "label": "t:blocks.product-title.preset_default"
        },
        {
          "value": "p",
          "label": "t:blocks.product-title.preset_paragraph"
        },
        {
          "value": "h1",
          "label": "t:blocks.product-title.preset_h1"
        },
        {
          "value": "h2",
          "label": "t:blocks.product-title.preset_h2"
        },
        {
          "value": "h3",
          "label": "t:blocks.product-title.preset_h3"
        },
        {
          "value": "h4",
          "label": "t:blocks.product-title.preset_h4"
        },
        {
          "value": "h5",
          "label": "t:blocks.product-title.preset_h5"
        },
        {
          "value": "h6",
          "label": "t:blocks.product-title.preset_h6"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "t:labels.text_style",
      "options": [
        {
          "value": "text--title",
          "label": "t:options.text_style.title"
        },
        {
          "value": "text--subtitle",
          "label": "t:options.text_style.subtitle"
        },
        {
          "value": "text--normal",
          "label": "t:options.text_style.normal"
        }
      ],
      "default": "text--title"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:labels.alignment",
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "t:general.text"
    }
  ],
  "tag": null
}
{% endschema %}
