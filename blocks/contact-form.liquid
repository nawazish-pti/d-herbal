{% comment %}
  Contact form block — renders a Shopify `contact` form.
  Drops into any section that accepts @theme blocks (e.g. Custom Section).
{% endcomment %}
{{ 'contact-form.css' | asset_url | stylesheet_tag }}
{% liquid
  assign heading = block.settings.heading
  assign btn_align = block.settings.button_alignment | default: 'left'
%}

<div
  class="contact-form-block contact-form-block--align-{{ block.settings.alignment }}"
  style="
    --cf-accent: {{ block.settings.button_color }};
    --cf-accent-text: {{ block.settings.button_text_color }};
    --cf-radius: {{ block.settings.corner_radius }}px;
    --cf-gap: {{ block.settings.field_gap }}px;
  "
  {{ block.shopify_attributes }}
>
  {% if heading != blank %}
    <h2 class="contact-form-block__heading">{{ heading }}</h2>
  {% endif %}

  {% if block.settings.subheading != blank %}
    <div class="contact-form-block__subheading">{{ block.settings.subheading }}</div>
  {% endif %}

  {% form 'contact', class: 'contact-form-block__form' %}
    {% if form.posted_successfully? %}
      <p class="contact-form-block__notice contact-form-block__notice--success" tabindex="-1" autofocus>
        {{ block.settings.success_message | default: 'Thanks for reaching out! We’ll get back to you soon.' }}
      </p>
    {% elsif form.errors %}
      <div class="contact-form-block__notice contact-form-block__notice--error" tabindex="-1" autofocus>
        {{ form.errors | default_errors }}
      </div>
    {% endif %}

    <div class="contact-form-block__field">
      <label for="ContactName-{{ block.id }}">Name</label>
      <input
        type="text"
        id="ContactName-{{ block.id }}"
        name="contact[name]"
        value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
        autocomplete="name"
        placeholder="Your name"
      >
    </div>

    <div class="contact-form-block__field">
      <label for="ContactEmail-{{ block.id }}">Email <span aria-hidden="true">*</span></label>
      <input
        type="email"
        id="ContactEmail-{{ block.id }}"
        name="contact[email]"
        value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
        autocomplete="email"
        autocorrect="off"
        autocapitalize="off"
        required
        placeholder="you@example.com"
        aria-required="true"
      >
    </div>

    {% if block.settings.show_phone %}
      <div class="contact-form-block__field">
        <label for="ContactPhone-{{ block.id }}">Phone</label>
        <input
          type="tel"
          id="ContactPhone-{{ block.id }}"
          name="contact[phone]"
          value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
          autocomplete="tel"
          placeholder="Phone number"
        >
      </div>
    {% endif %}

    <div class="contact-form-block__field">
      <label for="ContactMessage-{{ block.id }}">Message <span aria-hidden="true">*</span></label>
      <textarea
        id="ContactMessage-{{ block.id }}"
        name="contact[body]"
        rows="{{ block.settings.message_rows }}"
        required
        placeholder="How can we help?"
        aria-required="true"
      >{% if form.body %}{{ form.body }}{% endif %}</textarea>
    </div>

    <div class="contact-form-block__actions contact-form-block__actions--{{ btn_align }}">
      <button type="submit" class="contact-form-block__button">
        {{ block.settings.button_label | default: 'Send' }}
      </button>
    </div>
  {% endform %}
</div>

{% stylesheet %}
  
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.contact_form.name",
  "settings": [
    {
      "type": "header",
      "content": "t:blocks.contact_form.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks.contact_form.heading",
      "default": "Get in touch"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:blocks.contact_form.subheading"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:blocks.contact_form.alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:blocks.contact_form.fields"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "t:blocks.contact_form.show_phone",
      "default": true
    },
    {
      "type": "range",
      "id": "message_rows",
      "label": "t:blocks.contact_form.message_rows.label",
      "info": "t:blocks.contact_form.message_rows.info",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "field_gap",
      "label": "t:blocks.contact_form.field_gap.label",
      "info": "t:blocks.contact_form.field_gap.info",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "t:blocks.contact_form.corner_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "header",
      "content": "t:blocks.contact_form.button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:blocks.button.label",
      "default": "Send"
    },
    {
      "type": "select",
      "id": "button_alignment",
      "label": "t:blocks.button.alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "t:blocks.button.background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:blocks.button.text_color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "t:blocks.contact_form.success"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "t:blocks.contact_form.success_message.label",
      "default": "t:blocks.contact_form.success_message.default"
    }
  ],
  "presets": [{ "name": "t:blocks.contact_form.name" }],
  "tag": null
}
{% endschema %}
