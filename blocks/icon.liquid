{% comment %}
  Icon block.

  Renders an SVG icon (from the `svg-icons` snippet) OR an uploaded image.
  - If an image is uploaded, it replaces the icon.
  - Width is controlled by a range setting.
  - If a link URL is set, the icon/image is wrapped in an <a>.

  {% content_for 'block', type: 'icon', id: 'icon' %}
{% endcomment %}
{{ 'icon.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign settings = block.settings
  assign has_image = false
  if settings.image != blank
    assign has_image = true
  endif
  assign has_link = false
  if settings.link != blank
    assign has_link = true
  endif
-%}

<div
  class="icon-block icon-block--align-{{ settings.alignment }}"
  style="--icon-block-width: {{ settings.width }}px; --icon-block-color: {{ settings.color }};"
  {{ block.shopify_attributes }}
>
  {%- if has_link -%}
    <a
      class="icon-block__inner"
      href="{{ settings.link }}"
      {% if settings.open_new_tab %}target="_blank" rel="noopener"{% endif %}
      {% if settings.aria_label != blank %}aria-label="{{ settings.aria_label | escape }}"{% endif %}
    >
  {%- else -%}
    <span class="icon-block__inner">
  {%- endif -%}

    {%- if has_image -%}
      {{
        settings.image
        | image_url: width: 800
        | image_tag:
          class: 'icon-block__img',
          widths: '100, 200, 300, 400, 600, 800',
          alt: settings.aria_label
      }}
    {%- else -%}
      <span class="icon-block__icon">
        {%- render 'icon', name: settings.icon -%}
      </span>
    {%- endif -%}

  {%- if has_link -%}
    </a>
  {%- else -%}
    </span>
  {%- endif -%}
</div>
 
{% comment %} {% stylesheet %}
  .icon-block {
    display: flex;
    box-sizing: border-box;
  }

  .icon-block--align-left {
    justify-content: flex-start;
  }
  .icon-block--align-center {
    justify-content: center;
  }
  .icon-block--align-right {
    justify-content: flex-end;
  }

  .icon-block__inner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--icon-block-width, 48px);
    max-width: 100%;
    color: var(--icon-block-color, currentColor);
    line-height: 0;
    text-decoration: none;
  }

  .icon-block__icon,
  .icon-block__icon svg,
  .icon-block__img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
  }


  a.icon-block__inner {
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  a.icon-block__inner:hover {
    opacity: 0.75;
  }
{% endstylesheet %} {% endcomment %}

{% schema %}
{
  "name": "Icon",
  "settings": [
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "info": "Ignored when an image is uploaded below.",
      "default": "star",
      "options": [
        { "group": "General", "value": "star", "label": "Star" },
        { "group": "General", "value": "search", "label": "Search" },
        { "group": "General", "value": "zoom", "label": "Zoom" },
        { "group": "General", "value": "cart-bag", "label": "Cart bag" },
        { "group": "General", "value": "shop-pay", "label": "Shop Pay" },
        { "group": "General", "value": "hamburger", "label": "Hamburger" },
        { "group": "General", "value": "close", "label": "Close" },
        { "group": "General", "value": "delete", "label": "Delete" },
        { "group": "General", "value": "plus", "label": "Plus" },
        { "group": "General", "value": "minus", "label": "Minus" },
        { "group": "General", "value": "error", "label": "Error" },
        { "group": "General", "value": "spinner", "label": "Spinner" },
        { "group": "General", "value": "play", "label": "Play" },
        { "group": "Arrows", "value": "arrow-left", "label": "Arrow left" },
        { "group": "Arrows", "value": "arrow-right", "label": "Arrow right" },
        { "group": "Arrows", "value": "arrow-down", "label": "Arrow down" },
        { "group": "Social", "value": "facebook", "label": "Facebook" },
        { "group": "Social", "value": "instagram", "label": "Instagram" },
        { "group": "Social", "value": "pinterest", "label": "Pinterest" },
        { "group": "Social", "value": "linkedin", "label": "LinkedIn" },
        { "group": "Social", "value": "twitter", "label": "Twitter" },
        { "group": "Social", "value": "youtube", "label": "YouTube" },
        { "group": "Social", "value": "tiktok", "label": "TikTok" },
        { "group": "Social", "value": "snapchat", "label": "Snapchat" },
        { "group": "Social", "value": "tumblr", "label": "Tumblr" },
        { "group": "Social", "value": "vimeo", "label": "Vimeo" },
        { "group": "Social", "value": "whatsapp", "label": "WhatsApp" },
        { "group": "Social", "value": "threads", "label": "Threads" },
        { "group": "Features", "value": "feature-sun", "label": "Sun" },
        { "group": "Features", "value": "feature-shield", "label": "Shield" },
        { "group": "Features", "value": "feature-smile", "label": "Smile" },
        { "group": "Features", "value": "feature-flask", "label": "Flask" },
        { "group": "USP", "value": "usp-box", "label": "Box" },
        { "group": "USP", "value": "usp-sun", "label": "Sun" },
        { "group": "USP", "value": "usp-phone", "label": "Phone" },
        { "group": "USP", "value": "usp-arrow-path", "label": "Arrow path" },
        { "group": "USP", "value": "usp-badge-check", "label": "Badge check" }
      ]
    },
    {
      "type": "color",
      "id": "color",
      "label": "Icon color",
      "default": "#1c274c"
    },
    {
      "type": "header",
      "content": "Image (overrides icon)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "When set, this image is shown instead of the selected icon."
    },
    {
      "type": "header",
      "content": "Size & alignment"
    },
    {
      "type": "range",
      "id": "width",
      "label": "Width",
      "min": 16,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "When set, the icon/image becomes a clickable link."
    },
    {
      "type": "checkbox",
      "id": "open_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "info": "Describes the icon/link for screen readers, and used as image alt text."
    }
  ],
  "tag": null,
  "presets": [{ "name": "Icon", "category": "Media" }]
}
{% endschema %}
