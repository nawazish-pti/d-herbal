{% doc %}
  Renders a text block.

  {% content_for 'block', type: 'text', id: 'text' %}
{% enddoc %}

{% assign product_data = closest.product %}

{% render 'text', block: block, settings: block.settings, product_data: product_data %}

{% schema %}
{
  "name": "Text 2",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "select",
      "id": "preset",
      "label": "Preset",
      "default": "rte",
      "options": [
        { "value": "rte", "label": "Default" },
        { "value": "p", "label": "Paragraph" },
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "custom", "label": "custom" }
      ]
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "t:labels.text_style",
      "options": [
        { "value": "text--title", "label": "t:options.text_style.title" },
        { "value": "text--subtitle", "label": "t:options.text_style.subtitle" },
        { "value": "text--normal", "label": "t:options.text_style.normal" }
      ],
      "default": "text--title"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:labels.alignment",
      "default": "left"
    }
  ],
  "tag": null,
  "presets": [{ "name": "Text 2" }]
}
{% endschema %}
