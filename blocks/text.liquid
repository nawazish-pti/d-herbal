        }
      ],
      "default": "14",
      "visible_if": "{{ block.settings.preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "custom_line_height",
      "label": "t:blocks.text.custom_line_height_line_height",
      "options": [
