{% doc %}
  Renders a text block.

  {% content_for 'block', type: 'text', id: 'text' %}
{% enddoc %}

{% assign product_data = closest.product %}

{% render 'text', block: block, settings: block.settings, product_data: product_data %}

{% schema %}
{
  "name": "t:general.text",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "select",
      "id": "preset",
      "label": "t:blocks.text.preset_preset",
      "default": "rte",
      "options": [
        {
          "value": "rte",
          "label": "t:blocks.text.preset_default"
        },
        {
          "value": "p",
          "label": "t:blocks.text.preset_paragraph"
        },
        {
          "value": "h1",
          "label": "t:blocks.text.preset_h1"
        },
        {
          "value": "h2",
          "label": "t:blocks.text.preset_h2"
        },
        {
          "value": "h3",
          "label": "t:blocks.text.preset_h3"
        },
        {
          "value": "h4",
          "label": "t:blocks.text.preset_h4"
        },
        {
          "value": "h5",
          "label": "t:blocks.text.preset_h5"
        },
        {
          "value": "h6",
          "label": "t:blocks.text.preset_h6"
        },
        {
          "value": "custom",
          "label": "t:blocks.text.preset_custom"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "t:labels.text_style",
      "options": [
        {
          "value": "text--title",
          "label": "t:options.text_style.title"
        },
        {
          "value": "text--subtitle",
          "label": "t:options.text_style.subtitle"
        },
        {
          "value": "text--normal",
          "label": "t:options.text_style.normal"
        }
      ],
      "default": "text--title",
      "visible_if": "{{ block.settings.preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "custom_size",
      "label": "t:blocks.text.custom_size_font_size",
      "options": [
        {
          "value": "10",
          "label": "10px"
