{% doc %}
  Renders a text block.

  {% content_for 'block', type: 'text', id: 'text' %}
{% enddoc %}

{% assign product_data = closest.product %}

{% render 'text', block: block, settings: block.settings, product_data: product_data %}

{% schema %}
{
  "name": "t:general.text",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "select",
      "id": "preset",
      "label": "Preset",
      "default": "rte",
      "options": [
        { "value": "rte", "label": "Default" },
        { "value": "p", "label": "Paragraph" },
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "custom", "label": "custom" }
      ]
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "t:labels.text_style",
      "options": [
        { "value": "text--title", "label": "t:options.text_style.title" },
        { "value": "text--subtitle", "label": "t:options.text_style.subtitle" },
        { "value": "text--normal", "label": "t:options.text_style.normal" }
      ],
      "default": "text--title",
      "visible_if": "{{ block.settings.preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "custom_size",
      "label": "Font Size",
      "options": [
        {
          "value": "10",
          "label": "10px"
        },
        {
          "value": "12",
          "label": "12px"
        },
        {
          "value": "14",
          "label": "14px"
        },
        {
          "value": "16",
          "label": "16px"
        },
        {
          "value": "18",
          "label": "18px"
        },
        {
          "value": "20",
          "label": "20px"
        },
        {
          "value": "24",
          "label": "24px"
        },
        {
          "value": "28",
          "label": "28px"
        },
        {
          "value": "32",
          "label": "32px"
        },
        {
          "value": "36",
          "label": "36px"
        },
        {
          "value": "40",
          "label": "40px"
        },
        {
          "value": "48",
          "label": "48px"
        },
        {
          "value": "56",
          "label": "56px"
        },
        {
          "value": "64",
          "label": "64px"
        },
        {
          "value": "72",
          "label": "72px"
        }
      ],
      "default": "14",
      "visible_if": "{{ block.settings.preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "custom_line_height",
      "label": "Line Height",
      "options": [
        {
          "value": "1.0",
          "label": "1.0"
        },
        {
          "value": "1.1",
          "label": "1.1"
        },
        {
          "value": "1.2",
          "label": "1.2"
        },
        {
          "value": "1.3",
          "label": "1.3"
        },
        {
          "value": "1.4",
          "label": "1.4"
        },
        {
          "value": "1.5",
          "label": "1.5"
        },
        {
          "value": "normal",
          "label": "Normal"
        }
      ],
      "default": "1.2",
      "visible_if": "{{ block.settings.preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "custom_letter_spacing",
      "label": "Letter Spacing",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "0.02em",
          "label": "0.02em"
        },
        {
          "value": "0.04em",
          "label": "0.04em"
        },
        {
          "value": "0.06em",
          "label": "0.06em"
        },
        {
          "value": "0.08em",
          "label": "0.08em"
        },
        {
          "value": "0.1em",
          "label": "0.1em"
        },
        {
          "value": "0.15em",
          "label": "0.15em"
        },
        {
          "value": "0.2em",
          "label": "0.2em"
        }
      ],
      "default": "normal",
      "visible_if": "{{ block.settings.preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "custom_case",
      "label": "Casing",
      "options": [
        {
          "value": "none",
          "label": "Default"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.preset == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_color",
      "label": "Text Color",
      "info": "Leave empty to use the global typography color.",
      "alpha": true,
      "default": "#00000000"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:labels.alignment",
      "default": "left"
    }
  ],
  "tag": null,
  "presets": [{ "name": "t:general.text" }]
}
{% endschema %}
