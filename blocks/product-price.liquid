{% assign product_data = closest.product %}
<div class=" product-card__block product-card__block--price" {{ block.shopify_attributes }}>
  <div class="product-card__pricing">
    <span class="{{block.settings.show_compare }} main_price">{{ product_data.price | money }}</span>
    {% if block.settings.show_compare and product_data.compare_at_price > product_data.price %}
      <span class="compare_price">{{ product_data.compare_at_price | money }}</span>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:blocks.product-price.product_price",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_compare",
      "label": "t:blocks.product-price.show_compare_show_compare_at_price",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:blocks.product-price.price"
    }
  ],
  "tag": null
}
{% endschema %}
