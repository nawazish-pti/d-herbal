{% comment %} Image block — renders the `image` snippet and passes settings. {% endcomment %}

{%- liquid
  if block.settings.overlay_opacity > 0
    assign overlay_color = block.settings.overlay_color
    assign overlay_opacity = block.settings.overlay_opacity
  endif
-%}

<div class="image-block" {{ block.shopify_attributes }}>
  {% render 'image',
    image: block.settings.image,
    mobile_image: block.settings.mobile_image,
    url: block.settings.link,
    aspect_ratio: block.settings.aspect_ratio,
    object_fit: block.settings.object_fit,
    hover_effect: block.settings.hover_effect,
    loading: block.settings.loading,
    alt: block.settings.alt,
    overlay_color: overlay_color,
    overlay_opacity: overlay_opacity
  %}
</div>

{% schema %}
{
  "name": "Image",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image",
      "info": "Optional. Shown on screens under 768px."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Alt text",
      "info": "Leave empty to use the image's alt text."
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect Ratio",
      "options": [
        { "value": "", "label": "Default (global)" },
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (2:3)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "wide", "label": "Wide (16:9)" }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "object_fit",
      "label": "Image Fit",
      "options": [
        { "value": "", "label": "Default (global)" },
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "hover_effect",
      "label": "Hover Effect",
      "options": [
        { "value": "", "label": "Default (global)" },
        { "value": "none", "label": "None" },
        { "value": "zoom", "label": "Zoom" },
        { "value": "lift", "label": "Lift" },
        { "value": "fade", "label": "Fade" }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "loading",
      "label": "Loading",
      "options": [
        { "value": "lazy", "label": "Lazy" },
        { "value": "eager", "label": "Eager" }
      ],
      "default": "lazy",
      "info": "Use Eager for above-the-fold images."
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0,
      "info": "Set to 0 to disable the overlay."
    }
  ],
  "presets": [{ "name": "Image", "category": "Media" }],
  "tag": null
}
{% endschema %}
