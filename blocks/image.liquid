{% comment %} Image block — renders the `block-image` snippet and passes settings and objects. {% endcomment %}

{% render 'block-image', block: block, settings: block.settings %}

{% stylesheet %}
  :root {
    --block-image-radius: 8px;
    --block-image-transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    --block-image-overlay-bg: rgba(0, 0, 0, 0.45);
    --block-image-overlay-color: #ffffff;
    --block-image-placeholder-bg: #f5f5f7;
  }

  .block-image {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    margin-left: auto;
    margin-right: auto;
    box-sizing: border-box;
  }

  /* Size Aspect Ratios */
  .block-image--size-square .block-image__inner {
    aspect-ratio: 1 / 1;
    width: auto;
    height: auto;
  }

  .block-image--size-portrait .block-image__inner {
    aspect-ratio: 3 / 4;
    width: auto;
    height: auto;
  }

  .block-image--size-landscape .block-image__inner {
    aspect-ratio: 3 / 2;
    width: auto;
    height: auto;
  }

  .block-image--size-adapt .block-image__inner {
    aspect-ratio: auto;
    width: 100%;
    height: 100%;
  }

  .block-image__inner {
    position: relative;
    overflow: hidden;
    border-radius: var(--block-image-radius, 8px);
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    transform: translateZ(0);
    box-sizing: border-box;
  }

  .block-image__link {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
  }

  .block-image__img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    transition: var(--block-image-transition);
  }

  /* Force image to fill ratio container when ratio is active or cover is enabled */
  .block-image--size-square .block-image__img,
  .block-image--size-portrait .block-image__img,
  .block-image--size-landscape .block-image__img,
  .block-image--cover .block-image__img {
    width: 100%;
    height: 100%;
  }

  .block-image--cover .block-image__img {
    object-fit: cover;
  }

  .block-image:not(.block-image--cover) .block-image__img {
    object-fit: contain;
  }

  .block-image__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--block-image-overlay-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    box-sizing: border-box;
    text-decoration: none;
    opacity: 0;
    transition: var(--block-image-transition);
    z-index: 2;
  }

  .block-image__overlay--link {
    cursor: pointer;
  }

  .block-image__overlay-text {
    color: var(--block-image-overlay-color, #ffffff);
    font-size: 1.25rem;
    font-weight: 600;
    text-align: center;
    line-height: 1.4;
    transform: translateY(10px);
    transition: var(--block-image-transition);
  }

  .block-image__inner:hover .block-image__img {
    transform: scale(1.04);
  }

  .block-image__inner:hover .block-image__overlay {
    opacity: 1;
  }

  .block-image__inner:hover .block-image__overlay-text {
    transform: translateY(0);
  }

  .block-image__placeholder-wrapper {
    background-color: var(--block-image-placeholder-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    box-sizing: border-box;
  }

  .block-image--size-adapt .block-image__placeholder-wrapper {
    aspect-ratio: 16 / 9;
  }

  .block-image__placeholder {
    width: 60px;
    height: 60px;
    fill: #a0a0a5;
    max-width: 100%;
    max-height: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "url",
      "id": "link",
      "label": "link"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "adapt", "label": "Auto" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "adapt"
    },
    { "type": "checkbox", "id": "overlay_enable", "label": "Enable overlay link", "default": false },
    { "type": "text", "id": "overlay_text", "label": "Overlay text" },
    { "type": "url", "id": "overlay_link", "label": "Overlay link" },
    { "type": "checkbox", "id": "link_new_tab", "label": "Open link in new tab", "default": false },
    { "type": "text", "id": "alt", "label": "Alt text" },
    { "type": "checkbox", "id": "fit_cover", "label": "Cover image (object-fit:cover)", "default": true }
  ],
  "presets": [{ "name": "Image", "category": "Media" }],
  "tag": null
}
{% endschema %}
