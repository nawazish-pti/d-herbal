{{ 'header.css' | asset_url | stylesheet_tag }}
<header>
  <div class="header_container" style="flex-direction:{{ section.settings.change_position }}">
    {% comment %} <div class="logo_menu_container"> {% endcomment %}
  <a href="{{ routes.root_url }}" class="header_logo_link">
    {% if section.settings.logo != blank %}
      <div class="header_logo_wrapper">
        {% assign img_alt = section.settings.img_alt | default: shop.name | escape %}
        {%- assign logo_height = section.settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
        {{
          section.settings.logo
          | image_url: width: 600
          | image_tag:
            class: 'header__heading-logo motion-reduce',
            height: logo_height,
            width: section.settings.logo_width,
            alt: img_alt,
            preload: true
        }}
      </div>
    {% else %}
      <h2 class="header__title">
        {{ shop.name | link_to: routes.root_url }}
      </h2>
    {% endif %}
  </a>

  <div class="header__menu">
    {% if section.settings.main_menu != blank %}
      {% if section.settings.main_menu_type == 'mega-menu' %}
        {% render 'mega-menu' %}
      {% elsif section.settings.main_menu_type == 'dropdown' %}
        {% render 'dropdown' %}
      {% else %}
        {% render 'drawer' %}
      {% endif %}
    {% endif %}
  </div>
  {% comment %} </div> {% endcomment %}
  <div class="header__icons">
    {% if shop.customer_accounts_enabled %}
      {{ 'icon-account.svg' | inline_asset_content | link_to: routes.account_url }}
    {% endif %}
    {% comment %} {% if settings.cart_type == 'cart-page' %} {% endcomment %}
      <a href="{{ routes.cart_url }}" class="header-cart-icon">
        {% if cart.item_count > 0 %}
          <sup>{{ cart.item_count }}</sup>
        {% endif %}

        {{ 'icon-cart.svg' | inline_asset_content }}
      </a>
  </div>
  </div>
</header>
<div class="main-cart">
  <script src="{{ 'cart-global.js' | asset_url }}" defer></script>
  {% case settings.cart_type %}
    {% when 'cart-popup' %}
      {% render 'cart-popup' %}
    {% when 'cart-drawer' %}
      {% render 'drawer' %}

    {% when 'cart-page' %}
      {% comment %} <script src="{{ 'cart-page.js' | asset_url }}" defer></script> {% endcomment %}
  {% endcase %}
</div>
<script src="{{ 'nav-menu.js' | asset_url }}" defer></script>
{% stylesheet %}
  /* header {
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  } */
  header a {
    position: relative;
    text-decoration: none;
    color: var(--color-foreground);
  }
  header a sup {
    position: absolute;
    left: 100%;
    overflow: hidden;
    max-width: var(--page-margin);
  }
  header svg {
    width: 2rem;
  }
  header .header__menu,
  header .header__icons {
    display: flex;
    gap: 1rem;
  }

  .header_container{
  display:flex;
  align-items:center;
  position:relative;
}



/* LEFT */
.header_container.logo-left{
  justify-content:flex-start;
  gap:2rem;
}

/* CENTER */
.header_container.logo-center{
  justify-content:space-between;
}

.header_container.logo-center .header_logo_link{
  position:absolute;
  left:50%;
  transform:translateX(-50%);
}

.header_container.logo-center .header__menu,
.header_container.logo-center .header__icons{
  width:33.33%;
  display:flex;
}

.header_container.logo-center .header__menu{
  justify-content:flex-start;
}

.header_container.logo-center .header__icons{
  justify-content:flex-end;
}

/* RIGHT */
.header_container.logo-right{
  flex-direction:row-reverse;
  justify-content:space-between;
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "img_alt",
      "label": "Alt",
      "default": "Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Width",
      "min": 20,
      "max": 200,
      "step": 10,
      "default": 20
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "t:labels.menu"
    },
    {
      "type": "select",
      "id": "main_menu_type",
      "label": "Menu Type",
      "options": [
        {
          "label": "Mega Menu",
          "value": "mega-menu"
        },
        {
          "label": "Dropdown",
          "value": "dropdown"
        },
        {
          "label": "Drawer",
          "value": "drawer"
        }
      ]
    },
    {
      "type": "select",
      "id": "change_position",
      "label": "Logo Position",
      "info": "Inter chnage logo and Header icons Position",
      "options": [
        {
          "value": "none",
          "label": "Left"
        },
        {
          "value": "",
          "label": "Center"
        },
        {
          "value": "row-reverse",
          "label": "Right"
        }
      ]
    }
  ],
  "class": "header_group_section"
}
{% endschema %}
