{% stylesheet %}
  .product-card {
    width: 100%;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    overflow: hidden;
    box-sizing: border-box;
  }
  .featured-collection .slick-dots {
    bottom: -25px !important;
  }
{% endstylesheet %}

<div class="featured-collection" style="--slides-per-view: {{ section.settings.slides_per_view }}; --grid-columns: {{ section.settings.grid_columns }}">
  <div class="featured-collection__header">
    {% if section.settings.title != blank %}
      <h2 class="featured-collection__title">{{ section.settings.title }}</h2>
    {% endif %}
      {% if section.settings.description %}
      <p>{{ section.settings.description }}</p>
    {% endif %}
  </div>

  {% if section.settings.collection %}
    <div class="slider-container">
      <div class="featured-collection__products" data-slider>
        {% if section.settings.enable_slider %}
          {% for product in section.settings.collection.products %}
            <div class="product-card">
              {% render 'product-card', product: product, img_ratio: settings.image_ratio, hover_secondary: settings.hover_secondary %}
            </div>
          {% endfor %}
        {% else %}
          {% for product in section.settings.collection.products limit: section.settings.products_limit %}
            <div class="product-card">
              {% render 'product-card', product: product, img_ratio: settings.image_ratio, hover_secondary: settings.hover_secondary %}
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>

    {% if section.settings.view_all_enable %}
    <div class="view_all_btn {{ section.settings.arrow_enable }}">
      <a href="{{ section.settings.collection.url }}" class="view-all-btn">
      View All Products
      </a>
    </div>
    {% endif %}
  {% endif %}
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var $slider = $('[data-slider]');
  if (!$slider.length || typeof $slider.slick !== 'function' || !{{ section.settings.enable_slider | json }}) return;

  $slider.each(function () {
    var $this = $(this);

    $this.slick({
      slidesToShow: {{ section.settings.slides_per_view }},
      slidesToScroll: 1,
      infinite: true,
      dots: {{ section.settings.dot_enable | json }},
      arrows: {{ section.settings.arrow_enable | json }},
      autoplay: {{ section.settings.autoplay | json }},
      autoplaySpeed: {{ section.settings.autoplay_speed }} * 1000,
      pauseOnHover: {{ section.settings.pause_on_hover | json }},

      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: Math.min({{ section.settings.slides_per_view }}, 2),
            slidesToScroll: 1
          }
        },
        {
          breakpoint: 768,
          settings: {
            slidesToShow: 1,
            slidesToScroll: 1
          }
        }
      ]
    });
  });
});
</script> 


{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Featured Collection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Total Products to Show",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 8,
      "visible_if": "{{ section.settings.enable_slider == false }}"
    },
    {
      "type": "header",
      "content": "Slider settings"
    },
    {
      "type": "checkbox",
      "id": "enable_slider",
      "label": "Slider"
    },
    {
      "type": "range",
      "id": "slides_per_view",
      "label": "Slides Per View (Desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "grid_columns",
      "label": "Products Per Row",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay Speed (seconds)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "dot_enable",
      "label": "Enble Dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "arrow_enable",
      "label": "Enable Arrows",
      "default": false  
    },
    {
      "type": "checkbox",
      "id": "view_all_enable",
      "label": "View All",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}