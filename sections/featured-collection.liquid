{% stylesheet %}
  .product-card {
    width: 100%;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    overflow: hidden;
    box-sizing: border-box;
  }

  .featured-collection__products {
    width: 100%;
  }

  .featured-collection__products--grid {
    display: grid;
    grid-auto-rows: auto;
    grid-template-columns: repeat(var(--products-per-row, 4), minmax(0, 1fr));
    gap: 1rem;
  }

  .featured-collection__products--grid > .product-card {
    width: auto;
    min-width: 0;
  }
{% endstylesheet %}

<div
  class="featured-collection"
  style="--slides-per-view: {{ section.settings.slides_per_view }}; --products-per-row: {{ section.settings.products_per_row }}"
>
  <div class="featured-collection__header">
    {% if section.settings.title != blank %}
      <h2 class="featured-collection__title">{{ section.settings.title }}</h2>
    {% endif %}
    {% if section.settings.description %}
      <p>{{ section.settings.description }}</p>
    {% endif %}
  </div>

  {% if section.settings.collection %}
    {% if section.settings.layout_type == 'slider' %}
      <div class="slider-container">
        <div class="featured-collection__products" data-slider>
          {% for product in section.settings.collection.products limit: section.settings.products_limit %}
            <div class="product-card">
              {% content_for 'block',
                type: 'product-card',
                id: 'product-card-slider',
                product: product,
                closest.product: product
              %}
            </div>
          {% endfor %}
        </div>
      </div>
    {% else %}
      <div class="featured-collection__products featured-collection__products--grid">
        {% for product in section.settings.collection.products limit: section.settings.products_limit %}
          <div class="product-card">
            {% content_for 'block',
              type: 'product-card',
              id: 'product-card',
              product: product,
              closest.product: product
            %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.view_all_enable %}
      <div class="view_all_btn">
        <a href="{{ section.settings.collection.url }}" class="view-all-btn"> View All Products </a>
      </div>
    {% endif %}
  {% endif %}
</div>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var $slider = $('[data-slider]');
    if (!$slider.length || typeof $slider.slick !== 'function') return;

    $slider.each(function () {
      var $this = $(this);

      $this.slick({
        slidesToShow: {{ section.settings.slides_per_view }},
        slidesToScroll: 1,
        infinite: true,
        dots: {{ section.settings.dot_enable }},
        arrows: {{ section.settings.arrow_enable }},
        autoplay: {{ section.settings.autoplay }},
        autoplaySpeed: {{ section.settings.autoplay_speed }} * 1000,
        pauseOnHover: {{ section.settings.pause_on_hover | json }},
        responsive: [
          {
            breakpoint: 1024,
            settings: {
              slidesToShow: Math.min({{ section.settings.slides_per_view }}, 2),
              slidesToScroll: 1
            }
          },
          {
            breakpoint: 768,
            settings: {
              slidesToShow: 1,
              slidesToScroll: 1
            }
          }
        ]
      });
    });
  });
</script>

{% schema %}
{
  "name": "t:sections.featured-collection.featured_collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.featured-collection.title_section_title",
      "default": "Featured Collection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.featured-collection.description_description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured-collection.collection_select_collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "t:sections.featured-collection.products_limit_total_products_to_show",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:sections.featured-collection.layout_type_layout",
      "default": "slider",
      "options": [
        {
          "value": "slider",
          "label": "t:sections.featured-collection.layout_type_slider"
        },
        {
          "value": "grid",
          "label": "t:sections.featured-collection.layout_type_grid"
        }
      ]
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "t:sections.featured-collection.products_per_row_products_per_row",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 4,
      "info": "t:sections.featured-collection.products_per_row_grid_layout_only",
      "visible_if": "{{ section.settings.layout_type =='grid' }}"
    },
    {
      "type": "header",
      "content": "t:sections.featured-collection.slider_settings",
      "visible_if": "{{ section.settings.layout_type == 'slider' }}"
    },
    {
      "type": "range",
      "id": "slides_per_view",
      "label": "t:sections.featured-collection.slides_per_view_slides_per_view_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout_type == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.featured-collection.autoplay_enable_autoplay",
      "default": false,
      "visible_if": "{{ section.settings.layout_type == 'slider' }}"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "t:sections.featured-collection.autoplay_speed_autoplay_speed_seconds",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.layout_type == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "t:sections.featured-collection.pause_on_hover_pause_on_hover",
      "default": true,
      "visible_if": "{{ section.settings.layout_type == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "dot_enable",
      "label": "t:sections.featured-collection.dot_enable_enble_dots",
      "default": false,
      "visible_if": "{{ section.settings.layout_type == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "arrow_enable",
      "label": "t:sections.featured-collection.arrow_enable_enable_arrows",
      "default": false,
      "visible_if": "{{ section.settings.layout_type == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "view_all_enable",
      "label": "t:sections.featured-collection.view_all_enable_view_all",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-collection.featured_collection"
    }
  ]
}
{% endschema %}
