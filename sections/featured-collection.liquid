{% stylesheet %}
  .product-card {
    width: 100%;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    overflow: hidden;
    box-sizing: border-box;
  }

{% endstylesheet %}

<div class="featured-collection" style="--slides-per-view: {{ section.settings.slides_per_view | default: 1 }}">
  <div class="featured-collection__header">
    {% if section.settings.title != blank %}
      <h2 class="featured-collection__title">{{ section.settings.title }}</h2>
    {% endif %}
      {% if section.settings.description %}
      <p>{{ section.settings.description }}</p>
    {% endif %}
  </div>

  {% if section.settings.collection %}
    {% if section.settings.layout_type == 'slider' %}
      <div class="slider-container">
        <div class="featured-collection__products" data-slider>
          {% for product in section.settings.collection.products limit: section.settings.products_limit %}
            <div class="product-card">
              {% content_for 'block', type: 'product-card', id: 'product-card-' | append: product.id, product: product %}
            </div>
          {% endfor %}
        </div>
      </div>
    {% else %}
      <div class="featured-collection__products grid products-per-row-{{ section.settings.products_per_row | default: 4 }}">
        {% for product in section.settings.collection.products limit: section.settings.products_limit %}
          <div class="product-card">
            {% content_for 'block', type: 'product-card', id: 'product-card-' | append: product.id, product: product %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.view_all_enable %}
    <div class="view_all_btn">
      <a href="{{ section.settings.collection.url }}" class="view-all-btn">
      View All Products
      </a>
    </div>
    {% endif %}
  {% endif %}
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var $slider = $('[data-slider]');
  if (!$slider) return;
  if (!$slider.length || typeof $slider.slick !== 'function') return;

  $slider.each(function () {
    var $this = $(this);

    $this.slick({
      slidesToShow: {{ section.settings.slides_per_view }},
      slidesToScroll: 1,
      infinite: true,
      dots: {{ section.settings.dot_enable }},
      arrows: {{ section.settings.arrow_enable }},
      autoplay: {{ section.settings.autoplay }},
      autoplaySpeed: {{ section.settings.autoplay_speed }} * 1000,
      pauseOnHover: {{ section.settings.pause_on_hover | json }},
      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: Math.min({{ section.settings.slides_per_view }}, 2),
            slidesToScroll: 1
          }
        },
        {
          breakpoint: 768,
          settings: {
            slidesToShow: 1,
            slidesToScroll: 1
          }
        }
      ]
    });
  });
});
</script> 


{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout",
      "default": "slider",
      "options": [
        { "value": "slider", "label": "Slider" },
        { "value": "grid", "label": "Grid" }
      ]
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Featured Collection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Total Products to Show",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Slider settings",
      "visible_if": "{{ section.settings.layout_type == 'slider' }}"
    },
    {
      "type": "range",
      "id": "slides_per_view",
      "label": "Slides Per View (Desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout_type == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": false,
      "visible_if": "{{ section.settings.layout_type == 'slider' }}"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay Speed (seconds)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.layout_type == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true,
      "visible_if": "{{ section.settings.layout_type == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "dot_enable",
      "label": "Enable Dots",
      "default": false,
      "visible_if": "{{ section.settings.layout_type == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "arrow_enable",
      "label": "Enable Arrows",
      "default": false,
      "visible_if": "{{ section.settings.layout_type == 'slider' }}"
    },
    {
      "type": "header",
      "content": "Grid settings",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "Products per row (desktop)",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "checkbox",
      "id": "view_all_enable",
      "label": "View All",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}