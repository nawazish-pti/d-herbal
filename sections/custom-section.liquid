
{% assign direction_flex = section.settings.layout_direction %}

{% if section.settings.alignment == 'left' %}
  {% assign alignment_css = 'flex-start' %}
{% elsif section.settings.alignment == 'center' %}
  {% assign alignment_css = 'center' %}
{% else %}
  {% assign alignment_css = 'flex-end' %}
{% endif %}

{% if section.settings.position == 'top' %}
  {% assign position_css = 'flex-start' %}
{% elsif section.settings.position == 'center' %}
  {% assign position_css = 'center' %}
{% else %}
  {% assign position_css = 'flex-end' %}
{% endif %}

{% if section.settings.layout_direction == 'row' %}
  {% assign content_justify = alignment_css %}
  {% assign content_align = position_css %}
  {% assign content_wrap = 'wrap' %}
{% else %}
  {% assign content_justify = position_css %}
  {% assign content_align = alignment_css %}
  {% assign content_wrap = 'nowrap' %}
{% endif %}

{% if section.settings.section_height == 'small' %}
  {% assign section_height_value = '50svh' %}
{% elsif section.settings.section_height == 'medium' %}
  {% assign section_height_value = '65svh' %}
{% elsif section.settings.section_height == 'large' %}
  {% assign section_height_value = '80svh' %}
{% elsif section.settings.section_height == 'full_screen' %}
  {% assign section_height_value = '100svh' %}
{% elsif section.settings.section_height == 'custom' %}
  {% assign section_height_px = section.settings.section_height_custom | times: 10 %}
   {% assign section_height_value = section_height_px | append: 'px' %}
{% else %}
  {% assign section_height_value = 'auto' %}
{% endif %}

<div class="custom-section custom-section--{{ section.settings.layout_direction }}" style="">
  <div
    class="custom-section__content section-content-wrapper layout-panel-flex layout-panel-flex--{{ section.settings.layout_direction }}"
    style="display: flex; flex-direction: {{ direction_flex }}; flex-wrap: {{ content_wrap }}; justify-content: {{ content_justify }}; align-items: {{ content_align }}; gap: {{ section.settings.gap }}px; min-height: {{ section_height_value }};"
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .custom-section {
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }

  .custom-section__content {
    width: 100%;
    min-height: 0;
    box-sizing: border-box;
  }

  .custom-section__content > * {
    min-width: 0;
    max-width: 100%;
  }

  .section-content-wrapper.section-content-wrapper:where(.layout-panel-flex) .group-block--fill {
    flex: 1;
  }

  .layout-panel-flex--row > .group-block--width-fit {
    flex: 0;
  }

  .layout-panel-flex--row > .group-block--width-fill {
    flex: 1;
  }

  .layout-panel-flex--row > .group-block--width-custom {
    flex-basis: var(--size-style-width);
  }

  .layout-panel-flex--column > .group-block--height-fit {
    flex: 0 1 auto;
  }

  .layout-panel-flex--column > .group-block--height-fill {
    flex: 1;
  }

  .layout-panel-flex--column > .group-block--height-custom {
    flex-basis: var(--size-style-height);
  }

  .layout-panel-flex--column > .group-block--width-fill {
    align-self: stretch;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.custom-section.custom_section",
  "settings": [
    {
      "type": "select",
      "id": "layout_direction",
      "label": "t:sections.custom-section.layout_direction_layout_direction",
      "default": "column",
      "options": [
        {
          "value": "column",
          "label": "t:sections.custom-section.layout_direction_vertical"
        },
        {
          "value": "row",
          "label": "t:sections.custom-section.layout_direction_horizontal"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "vertical_mobile",
      "label": "t:sections.custom-section.vertical_mobile_vertical_on_mobile",
      "visible_if": "{{ section.settings.layout_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.custom-section.alignment_alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:sections.custom-section.alignment_left"
        },
        {
          "value": "center",
          "label": "t:sections.custom-section.alignment_center"
        },
        {
          "value": "right",
          "label": "t:sections.custom-section.alignment_right"
        }
      ]
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:sections.custom-section.position_position",
      "default": "top",
      "options": [
        {
          "value": "top",
          "label": "t:sections.custom-section.position_top"
        },
        {
          "value": "center",
          "label": "t:sections.custom-section.position_center"
        },
        {
          "value": "bottom",
          "label": "t:sections.custom-section.position_bottom"
        }
      ]
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:sections.custom-section.section_height_section_height",
      "default": "small",
      "options": [
        {
          "value": "small",
          "label": "t:sections.custom-section.section_height_small_50svh"
        },
        {
          "value": "medium",
          "label": "t:sections.custom-section.section_height_medium_65svh"
        },
        {
          "value": "large",
          "label": "t:sections.custom-section.section_height_large_80svh"
        },
        {
          "value": "full_screen",
          "label": "t:sections.custom-section.section_height_full_screen_100svh"
        },
        {
          "value": "custom",
          "label": "t:sections.custom-section.section_height_custom"
        }
      ]
    },
    {
      "type": "range",
      "id": "section_height_custom",
      "label": "t:sections.custom-section.section_height_custom_custom_height",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.section_height == 'custom' }}"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.custom-section.section_width_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:sections.custom-section.section_width_page"
        },
        {
          "value": "full-width",
          "label": "t:sections.custom-section.section_width_full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:sections.custom-section.gap_gap_between_blocks",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom-section.custom_section"
    }
  ]
}
{% endschema %}
