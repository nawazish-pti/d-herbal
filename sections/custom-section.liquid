
{% assign direction_flex = section.settings.layout_direction %}

{% if section.settings.alignment == 'left' %}
  {% assign alignment_css = 'flex-start' %}
{% elsif section.settings.alignment == 'center' %}
  {% assign alignment_css = 'center' %}
{% else %}
  {% assign alignment_css = 'flex-end' %}
{% endif %}

{% if section.settings.position == 'top' %}
  {% assign position_css = 'flex-start' %}
{% elsif section.settings.position == 'center' %}
  {% assign position_css = 'center' %}
{% else %}
  {% assign position_css = 'flex-end' %}
{% endif %}

{% if section.settings.layout_direction == 'row' %}
  {% assign content_justify = alignment_css %}
  {% assign content_align = position_css %}
  {% assign content_wrap = 'wrap' %}
{% else %}
  {% assign content_justify = position_css %}
  {% assign content_align = alignment_css %}
  {% assign content_wrap = 'nowrap' %}
{% endif %}

{% if section.settings.section_height == 'small' %}
  {% assign section_height_value = '50svh' %}
{% elsif section.settings.section_height == 'medium' %}
  {% assign section_height_value = '65svh' %}
{% elsif section.settings.section_height == 'large' %}
  {% assign section_height_value = '80svh' %}
{% elsif section.settings.section_height == 'full_screen' %}
  {% assign section_height_value = '100svh' %}
{% elsif section.settings.section_height == 'custom' %}
  {% assign section_height_px = section.settings.section_height_custom | times: 10 %}
   {% assign section_height_value = section_height_px | append: 'px' %}
{% else %}
  {% assign section_height_value = 'auto' %}
{% endif %}

<div class="custom-section custom-section--{{ section.settings.layout_direction }}" style="">
  <div
    class="custom-section__content section-content-wrapper layout-panel-flex layout-panel-flex--{{ section.settings.layout_direction }}"
    style="display: flex; flex-direction: {{ direction_flex }}; flex-wrap: {{ content_wrap }}; justify-content: {{ content_justify }}; align-items: {{ content_align }}; gap: {{ section.settings.gap }}px; min-height: {{ section_height_value }};"
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .custom-section {
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }

  .custom-section__content {
    width: 100%;
    min-height: 0;
    box-sizing: border-box;
  }

  .custom-section__content > * {
    min-width: 0;
    max-width: 100%;
  }

  .section-content-wrapper.section-content-wrapper:where(.layout-panel-flex) .group-block--fill {
    flex: 1;
  }

  .layout-panel-flex--row > .group-block--width-fit {
    flex: 0;
  }

  .layout-panel-flex--row > .group-block--width-fill {
    flex: 1;
  }

  .layout-panel-flex--row > .group-block--width-custom {
    flex-basis: var(--size-style-width);
  }

  .layout-panel-flex--column > .group-block--height-fit {
    flex: 0 1 auto;
  }

  .layout-panel-flex--column > .group-block--height-fill {
    flex: 1;
  }

  .layout-panel-flex--column > .group-block--height-custom {
    flex-basis: var(--size-style-height);
  }

  .layout-panel-flex--column > .group-block--width-fill {
    align-self: stretch;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom Section",
  "settings": [
    {
      "type": "select",
      "id": "layout_direction",
      "label": "Layout direction",
      "default": "column",
      "options": [
        { "value": "column", "label": "Vertical" },
        { "value": "row", "label": "Horizontal" }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section height",
      "default": "small",
      "options": [
        { "value": "small", "label": "Small (50svh)" },
        { "value": "medium", "label": "Medium (65svh)" },
        { "value": "large", "label": "Large (80svh)" },
        { "value": "full_screen", "label": "Full Screen (100svh)" },
        { "value": "custom", "label": "Custom" }
      ]
    },
    {
      "type": "range",
      "id": "section_height_custom",
      "label": "Custom height (%)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.section_height == 'custom' }}"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between blocks",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [{ "type": "@theme" }],
  "presets": [
    {
      "name": "Custom Section"
    }
  ]
}
{% endschema %}
