{% assign direction_flex = section.settings.layout_direction %}

{% if section.settings.alignment == 'left' %}
  {% assign alignment_css = 'flex-start' %}
{% elsif section.settings.alignment == 'center' %}
  {% assign alignment_css = 'center' %}
{% else %}
  {% assign alignment_css = 'flex-end' %}
{% endif %}

{% if section.settings.position == 'top' %}
  {% assign position_css = 'flex-start' %}
{% elsif section.settings.position == 'center' %}
  {% assign position_css = 'center' %}
{% else %}
  {% assign position_css = 'flex-end' %}
{% endif %}

{% if section.settings.layout_direction == 'row' %}
  {% assign content_justify = alignment_css %}
  {% assign content_align = position_css %}
{% else %}
  {% assign content_justify = position_css %}
  {% assign content_align = alignment_css %}
{% endif %}

<div class="custom-section custom-section--{{ section.settings.layout_direction }}" style="height: {{ section.settings.section_height }};">
  <div class="custom-section__content" style="display: flex; flex-direction: {{ direction_flex }}; flex-wrap: wrap; justify-content: {{ content_justify }}; align-items: {{ content_align }}; gap: {{ section.settings.gap }}px;">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .custom-section {
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }

  .custom-section__content {
    width: 100%;
    min-height: 0;
  }

  .custom-section__content > * {
    min-width: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom Section",
  "settings": [
    {
      "type": "select",
      "id": "layout_direction",
      "label": "Layout direction",
      "default": "column",
      "options": [
        { "value": "column", "label": "Vertical" },
        { "value": "row", "label": "Horizontal" }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between blocks",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [{ "type": "@theme" }],
  "presets": [
    {
      "name": "Custom Section"
    }
  ]
}
{% endschema %}
