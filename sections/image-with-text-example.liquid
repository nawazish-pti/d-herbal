{% comment %}
  Example Image Section
  
  Demonstrates how to use the image-schema snippet and block-image/image snippets
  in a section with full adjustable settings.
{% endcomment %}

<section class="image-with-text-section" style="
  --section-padding-top: {{ section.settings.padding_top }}px;
  --section-padding-bottom: {{ section.settings.padding_bottom }}px;
">
  <div class="image-with-text-section__container container-width">
    
    {%- if section.settings.heading != blank -%}
      <div class="image-with-text-section__header">
        <h2 class="image-with-text-section__heading h2">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="image-with-text-section__content image-with-text-section__content--layout-{{ section.settings.layout }}">
      
      {%- comment -%} Image Column {%- endcomment -%}
      <div class="image-with-text-section__image-column">
        {% render 'block-image', 
          settings: section.settings,
          prefix: 'image_'
        %}
      </div>

      {%- comment -%} Text Column {%- endcomment -%}
      <div class="image-with-text-section__text-column">
        {%- if section.settings.subheading != blank -%}
          <p class="image-with-text-section__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        
        {%- if section.settings.text != blank -%}
          <div class="image-with-text-section__text">
            {{ section.settings.text }}
          </div>
        {%- endif -%}
        
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="image-with-text-section__button buttons">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% stylesheet %}
  .image-with-text-section {
    padding-top: var(--section-padding-top, 50px);
    padding-bottom: var(--section-padding-bottom, 50px);
  }

  .image-with-text-section__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .image-with-text-section__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .image-with-text-section__heading {
    margin: 0;
  }

  .image-with-text-section__content {
    display: grid;
    gap: 40px;
    align-items: center;
  }

  .image-with-text-section__content--layout-image_first {
    grid-template-columns: 1fr 1fr;
  }

  .image-with-text-section__content--layout-text_first {
    grid-template-columns: 1fr 1fr;
  }

  .image-with-text-section__content--layout-text_first .image-with-text-section__image-column {
    order: 2;
  }

  .image-with-text-section__content--layout-text_first .image-with-text-section__text-column {
    order: 1;
  }

  .image-with-text-section__subheading {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 15px;
    color: #666;
  }

  .image-with-text-section__text {
    margin-bottom: 25px;
    line-height: 1.6;
  }

  .image-with-text-section__button {
    display: inline-block;
  }

  @media (max-width: 768px) {
    .image-with-text-section__content--layout-image_first,
    .image-with-text-section__content--layout-text_first {
      grid-template-columns: 1fr;
    }

    .image-with-text-section__content--layout-text_first .image-with-text-section__image-column,
    .image-with-text-section__content--layout-text_first .image-with-text-section__text-column {
      order: unset;
    }
  }
{% endstylesheet %}

{% schema %}
