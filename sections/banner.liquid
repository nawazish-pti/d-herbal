<div class="main_banner">
  <div class="image_container">
    {% if section.settings.banner_image != blank %}
      <div class="image_wrapper">
        {% render 'image', image: section.settings.banner_image, class: 'main_banner_image', width: 1600 %}
      </div>
    {% endif %}
    <div class="image_content_container {{ section.settings.text_align }} {{ section.settings.text_position }} ">
      <div class="image_content ">
        <h1>Heading</h1>
        <p>Data</p>
      </div>
    </div>
  </div>
</div>
<style>
  .shopify_banner{
      display:block;
  }
  .image_container {
    position: relative;
  }
  .image_content_container {
    position: absolute;
    align-items: center;
    height: 80%;
    top: 10%;
    left: 20%;
    width: 30%;
  }
  .image_content_container.right{
    right:10%;
    left:auto;
  }
  .image_content_container.top{
    align-items:flex-start;
  },
  .image_content_container.center{
    align-items:center;
  },
  .image_content_container.bottom{
    align-items:flex-end;
  }
  .image_content {
      padding: 20px;
  }
</style>
{% schema %}
{
  "name": "Banner",
  "class": "shopify_banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Align Item",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Box Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner"
    }
  ]
}
{% endschema %}
