<div class="main_banner">
  <div class="image_container">
    {% if section.settings.media_type == 'image' %}
      {% if section.settings.banner_image != blank %}
        <div class="image_wrapper">
          {% render 'image', image: section.settings.banner_image, class: 'main_banner_image', width: 1600 %}
        </div>
      {% endif %}
    {% else %}
      {% if section.settings.video_url != blank or section.settings.video_file != blank %}
        {% render 'video',
          video_url: section.settings.video_url,
          video_file: section.settings.video_file,
          poster: section.settings.video_poster,
          class: section.settings.video_class,
          width: section.settings.video_width,
          height: section.settings.video_height,
          autoplay: section.settings.autoplay,
          loop: section.settings.loop,
          muted: section.settings.muted,
          controls: section.settings.controls,
          playsinline: section.settings.playsinline,
          preload: section.settings.preload
        %}
      {% endif %}
    {% endif %}
    <div class="image_content_container {{ section.settings.text_align }} {{ section.settings.text_position }} ">
      <div class="image_content ">
        <h1>Heading</h1>
        <p>Data</p>
        {% if section.settings.btn_link != blank %}
          <a href="{{ section.settings.btn_link }}" class="button">{{ section.settings.btn_label }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</div>
<style>
  .shopify_banner{
      display:block;
  }
  .image_container {
    position: relative;
  }
  .image_content_container {
    display:flex;
    position: absolute;
    height: 80%;
    top: 10%;
    left: 20%;
    width: 30%;
  }

  .image_content_container.center-box{
    left: 50%;
    transform: translate(-50%);
    justify-content: center;
    align-items: center;
  }
  .image_content_container.right{
    right:10%;
    left:auto;
  }
  .image_content_container.top{
    align-items:flex-start;
  }
  .image_content_container.center{
    align-items:center;
  }
  .image_content_container.bottom {
      align-items: flex-end;
  }
  .image_content {
      padding: 20px;
  }
</style>
{% schema %}
{
  "name": "Banner",
  "class": "shopify_banner",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media Type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Image",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video_file",
      "label": "Upload Video",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Video Poster",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "text",
      "id": "video_class",
      "label": "Video Class",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false,
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop",
      "default": false,
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "Muted",
      "default": true,
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "controls",
      "label": "Show Controls",
      "default": true,
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "playsinline",
      "label": "Plays Inline",
      "default": true,
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "select",
      "id": "preload",
      "label": "Preload",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "metadata",
          "label": "Metadata"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "metadata",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "header",
      "content": "Text Box"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Align Item",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Box Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center-box",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Label",
      "default": "Button"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Banner"
    }
  ]
}
{% endschema %}
