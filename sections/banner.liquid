<div class="main_banner">
  <div class="image_container">
    {% if section.settings.media_type == 'image' %}
      {% if section.settings.banner_image != blank %}
        <div class="image_wrapper">
          {% render 'image', image: section.settings.banner_image, class: 'main_banner_image', width: 1600 %}
        </div>
      {% endif %}
    {% else %}
      {% if section.settings.video_url != blank or section.settings.video_file != blank %}
        {% render 'video',
          video_url: section.settings.video_url,
          video_file: section.settings.video_file,
          poster: section.settings.video_poster,
          class: section.settings.video_class,
          width: section.settings.video_width,
          height: section.settings.video_height,
          autoplay: section.settings.autoplay,
          loop: section.settings.loop,
          muted: section.settings.muted,
          controls: section.settings.controls,
          playsinline: section.settings.playsinline,
          preload: section.settings.preload
        %}
      {% endif %}
    {% endif %}
    <div class="image_content_container {{ section.settings.text_align }} {{ section.settings.text_position }} ">
      <div class="image_content ">
        <h1>Heading</h1>
        <p>Data</p>
        {% if section.settings.btn_link != blank %}
          <a href="{{ section.settings.btn_link }}" class="button">{{ section.settings.btn_label }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</div>
<style>

  .image_container {
    position: relative;
  }
  .image_content_container {
    display:flex;
    position: absolute;
    height: 80%;
    top: 10%;
    left: 20%;
    width: 30%;
  }

  .image_content_container.center-box{
    left: 50%;
    transform: translate(-50%);
    justify-content: center;
    align-items: center;
  }
  .image_content_container.right{
    right:10%;
    left:auto;
  }
  .image_content_container.top{
    align-items:flex-start;
  }
  .image_content_container.center{
    align-items:center;
  }
  .image_content_container.bottom {
      align-items: flex-end;
  }
  .image_content {
      padding: 20px;
  }
</style>
{% schema %}
{
  "name": "t:sections.banner.banner",
  "class": "shopify_full_width",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.banner.media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "t:sections.banner.media_type_media_type",
      "options": [
        {
          "value": "image",
          "label": "t:sections.banner.media_type_image"
        },
        {
          "value": "video",
          "label": "t:sections.banner.media_type_video"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "t:sections.banner.banner_image_image",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video_file",
      "label": "t:sections.banner.video_file_upload_video",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "t:sections.banner.video_url_video_url",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "t:sections.banner.video_poster_video_poster",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "text",
      "id": "video_class",
      "label": "t:sections.banner.video_class_video_class",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.banner.autoplay_autoplay",
      "default": false,
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "t:sections.banner.loop_loop",
      "default": false,
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "t:sections.banner.muted_muted",
      "default": true,
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "controls",
      "label": "t:sections.banner.controls_show_controls",
      "default": true,
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "playsinline",
      "label": "t:sections.banner.playsinline_plays_inline",
      "default": true,
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "select",
      "id": "preload",
      "label": "t:sections.banner.preload_preload",
      "options": [
        {
          "value": "auto",
          "label": "t:sections.banner.preload_auto"
        },
        {
          "value": "metadata",
          "label": "t:sections.banner.preload_metadata"
        },
        {
          "value": "none",
          "label": "t:sections.banner.preload_none"
        }
      ],
      "default": "metadata",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "header",
      "content": "t:sections.banner.text_box"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "t:sections.banner.text_position_align_item",
      "options": [
        {
          "value": "top",
          "label": "t:sections.banner.text_position_top"
        },
        {
          "value": "center",
          "label": "t:sections.banner.text_position_center"
        },
        {
          "value": "bottom",
          "label": "t:sections.banner.text_position_bottom"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:sections.banner.text_align_text_box_position",
      "options": [
        {
          "value": "left",
          "label": "t:sections.banner.text_align_left"
        },
        {
          "value": "center-box",
          "label": "t:sections.banner.text_align_center"
        },
        {
          "value": "right",
          "label": "t:sections.banner.text_align_right"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.banner.button"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "t:sections.banner.btn_label_label",
      "default": "Button"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "t:sections.banner.btn_link_button_link"
    }
  ],
  "presets": [
    {
      "name": "t:sections.banner.banner"
    }
  ]
}
{% endschema %}
