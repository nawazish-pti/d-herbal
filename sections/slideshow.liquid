<!-- -slideshow.liquid-- -->
{% assign section_setting = section.settings %}
<div
  class="main-slider"
  data-dots="{{ section_setting.dots }}"
  data-arrows="{{ section_setting.buttons }}"
  data-infinite="{{ section_setting.infinite }}"
  data-autoplay="{{ section_setting.autoplay }}"
>
  <div class="slider">
    {% content_for 'blocks' %}
  </div>
</div>
<style>
  .slick-dots {
    bottom: 30px;
  }
  .main_slide {
    position: relative;
  }
  .content_wraper_slide {
    position: absolute;
    top: 50%;
    left: 20%;
    padding: 20px;
    background: #fff;
    border-radius: 5px;
    height: auto;
    width: 100%;
    max-width: 30%;
  }
</style>
{% schema %}
{
  "name": "Main Slider",
  "settings": [
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "checkbox",
      "id": "dots",
      "label": "Dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "buttons",
      "label": "Buttons",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "infinite",
      "label": "Infinite",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false
    }
  ],
  "class": "shopify_full_width",
  "presets": [
    {
      "name": "Main Slider"
    }
  ],
  "blocks": [
    {
      "type": "slide"
    }
  ]
}
{% endschema %}
