<!-- -slideshow.liquid-- -->
{% assign section_setting = section.settings %}
<div
  class="main-slider"
  data-dots="{{ section_setting.dots }}"
  data-arrows="{{ section_setting.buttons }}"
  data-infinite="{{ section_setting.infinite }}"
  data-autoplay="{{ section_setting.autoplay }}"
>
  <div class="slider">
    {% content_for 'blocks' %}
  </div>
</div>
<style>
  .main-slider .slick-dots {
    bottom: 30px;
}
.main-slider .slick-dots li button:before {
    font-size: 50px;
    color: #dd0000 !important;
}
.main-slider .slick-next {
    right: 25px !important;
}
.main-slider .slick-prev {
    left: 25px !important;
    z-index:2;
}
.main-slider .slick-prev:before {
  content: "";
  display: block;
  width: 25px;
  height: 25px;
  background-image: url("{{ 'arrow-left.svg' | asset_url }}");
  background-repeat: no-repeat;
  background-size: contain;
  background-position: center;
}
.main-slider .slick-next:before {
  content: "";
  display: block;
  width: 25px;
  height: 25px;
  background-image: url("{{ 'arrow-right.svg' | asset_url }}");
  background-repeat: no-repeat;
  background-size: contain;
  background-position: center;
}
.content_wraper_slide {
    position: absolute;
    top: 50%;
    left: 20%;
    padding: 20px;
    background: #fff;
    border-radius: 5px;
    height: auto;
    width: 100%;
    max-width: 30%;
}
</style>
{% schema %}
{
  "name": "Main Slider",
  "settings": [
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "checkbox",
      "id": "dots",
      "label": "Dots",
      "default":false
    },
    {
      "type": "checkbox",
      "id": "buttons",
      "label": "Buttons",
      "default":false
    },
    {
      "type": "checkbox",
      "id": "infinite",
      "label": "Infinite",
      "default":false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default":false
    }
  ],
  "class": "shopify_full_width",
  "presets": [
    {
      "name": "Main Slider"
    }
  ],
  "blocks": [
    {
      "type": "slide"
    }
  ]
}
{% endschema %}
