<!-- -slideshow.liquid-- -->
{% assign section_setting = section.settings %}
<div
  class="main-slider"
  data-dots="{{ section_setting.dots }}"
  data-arrows="{{ section_setting.buttons }}"
  data-infinite="{{ section_setting.infinite }}"
>
  <div class="slider">
    {% content_for 'blocks' %}
  </div>
</div>

<script>

</script>
{% schema %}
{
  "name": "Main Slider",
  "settings": [
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "checkbox",
      "id": "dots",
      "label": "Dots"
    },
    {
      "type": "checkbox",
      "id": "buttons",
      "label": "Buttons"
    },
    {
      "type": "checkbox",
      "id": "infinite",
      "label": "Infinite"
    }
  ],
  "class": "shopify_full_width",
  "presets": [
    {
      "name": "Main Slider"
    }
  ],
  "blocks": [
    {
      "type": "slide"
    }
  ]
}
{% endschema %}
