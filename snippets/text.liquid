<div
  class="text {{ settings.text_style }} {{ settings.preset }}{% if settings.custom_color != blank and settings.custom_color.alpha != 0.0 %} has-custom-color{% endif %}"
  style="
    --text-align: {{ settings.alignment }};
    {%- if settings.custom_color != blank and settings.custom_color.alpha != 0.0 -%}
      --text-color: {{ settings.custom_color }};
    {%- endif -%}
    {%- if settings.preset == 'custom' -%}
      --font-size: {{ settings.custom_size | append: 'px' }};
      --line-height: {{ settings.custom_line_height }};
      --letter-spacing: {{ settings.custom_letter_spacing }};
      --text-transform: {{ settings.custom_case }};
    {%- endif -%}
  "
  {{ block.shopify_attributes }}
>
  {% if product_data != blank %}
    {{ product_data.title | strip_newlines | strip }}
  {% elsif settings.text != blank %}
    {{ settings.text | strip_newlines | strip }}
  {% endif %}
</div>
