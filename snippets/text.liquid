<div
  class="text {{ settings.text_style }} {{ settings.preset }}"
  style="--text-align: {{ settings.alignment }}"
  {{ block.shopify_attributes }}
>
  {% if product_data != blank %}
    {{ product_data.title | strip_newlines | strip }}
  {% elsif settings.text != blank %}
    {{ settings.text | strip_newlines | strip }}
  {% endif %}
</div>
