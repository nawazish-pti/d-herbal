<script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>
<div class="cart_main_drawer_container">
  <div class="drawer_header">
    <h2>Cart</h2>
    <button class="close_cart_popup_btn">
      {% render 'svg-icons', icon: 'cross' %}
    </button>
  </div>
  <div class="main_drawer_wrapper">
    <div class="drawer_line_items">
        {% render 'cart-items' %}
    </div>
    <div class="drawer_footer">
        <div class="total_price_drawer_footer">
            <p>Estimated Total</p>
            <p>Price</p>
        </div>
        <div class="cart_popup_actions">
            <a
              href="/checkout"
              class="cart_popup_checkout_btn"
            >
              Checkout
            </a>
          </div>
    </div>
  </div>
  <div class="empty_cart"></div>
</div>
<style>
    .cart_main_drawer_container {
    position: absolute;
    right: 0;
    top: 0;
    z-index: 999;
    background: #fff;
    height: 100vh;
}
.cart_main_drawer_container {
    position: fixed;
    top: 0;
    right: -450px;

    width: 100%;
    max-width: 400px;
    height: 100vh;

    background: #fff;

    z-index: 9999;

    transition: right 0.3s ease;

    display: flex;
    flex-direction: column;

    box-shadow:
      -5px 0 20px rgba(0,0,0,0.15);
}

.cart_main_drawer_container.is-open {
    right: 0;
}

.drawer_header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 20px;

    border-bottom: 1px solid #e5e5e5;
}

.drawer_header h2 {
    margin: 0;
    font-size: 22px;
}

.close_cart_popup_btn {
    background: transparent;
    border: 0;
    cursor: pointer;
}

.main_drawer_wrapper {
    display: flex;
    flex-direction: column;

    height: 100%;
}

.drawer_line_items {
    flex: 1;
    overflow-y: auto;

    padding: 20px;
}

.drawer_footer {
    border-top: 1px solid #e5e5e5;

    padding: 20px;
}

.total_price_drawer_footer {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 20px;
}

.cart_popup_checkout_btn {
    width: 100%;

    display: flex;
    align-items: center;
    justify-content: center;

    text-decoration: none;

    background: #000;
    color: #fff;

    min-height: 50px;

    border: 1px solid #000;
}

body.drawer-open {
    overflow: hidden;
}

@media screen and (max-width: 767px) {

    .cart_main_drawer_container {

        width: 100%;

    }

}
</style>