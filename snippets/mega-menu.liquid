<style>

</style>
<nav class="main-nav_mega">
  <ul class="nav-list nav-inline" role="list">
    {% for link in section.settings.main_menu.links %}
      <li class="nav-item">

        {% if link.links != blank %}
          <menu-drop>
            <details id="MenuGroup-{{ forloop.index }}" class="mega_menu">
              <summary
                id="MenuRoot-{{ link.handle }}"
                class="nav-trigger"
              >
                <span
                  {% if link.child_active %}
                    class="nav-link--active"
                  {% endif %}
                >
                  {{ link.title | escape }}
                </span>
                <span class="icon_caret">
                {{ 'icon-caret-down.svg' | inline_asset_content }}
                </span>
              </summary>

              <div
                id="MegaContent-{{ forloop.index }}"
                class="mega_menu-panel scheme-{{ section.settings.menu_color_scheme }}"
                tabindex="-1"
              >
                <ul
                  class="mega_menu-grid container-width{% if link.levels == 1 %} mega_menu-condensed{% endif %}"
                  role="list"
                >
                  {% for childlink in link.links %}
                    <li class="mega_menu-item">
                      <a
                        id="MenuRoot-{{ link.handle }}-{{ childlink.handle }}"
                        href="{{ childlink.url }}"
                        class="mega_menu-link lvl-2{% if childlink.current %} active{% endif %}"
                        {% if childlink.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ childlink.title | escape }}
                      </a>

                      {% if childlink.links != blank %}
                        <ul class="sublist" role="list">
                          {% for grandchildlink in childlink.links %}
                            <li>
                              <a
                                id="MenuRoot-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                href="{{ grandchildlink.url }}"
                                class="mega_menu-link lvl-3{% if grandchildlink.current %} active{% endif %}"
                                {% if grandchildlink.current %}
                                  aria-current="page"
                                {% endif %}
                              >
                                {{ grandchildlink.title | escape }}
                              </a>
                            </li>
                          {% endfor %}
                        </ul>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </div>

            </details>
          </menu-drop>

        {% else %}
          <a
            id="MenuRoot-{{ link.handle }}"
            href="{{ link.url }}"
            class="nav-link"
            {% if link.current %} aria-current="page" {% endif %}
          >
            <span {% if link.current %} class="nav-link--active" {% endif %}>
              {{ link.title | escape }}
            </span>
          </a>

        {% endif %}
      </li>
    {% endfor %}
  </ul>
</nav>
