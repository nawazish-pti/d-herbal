{% doc %}
  Renders an SVG icon by name with optional class name.

  @param {string} name - The identifier of the icon to render
  @param {string} [class] - Optional class to apply to the SVG element

  @example
  {% render 'icon', name: 'search', class: 'icon-search' %}
{% enddoc %}

{%- liquid
  assign icon_class = class | default: ''
-%} 

{%- case name -%}
  {%- when 'close' -%}
    <svg class="{{ icon_class }}" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
    </svg>

  {%- when 'delete' -%}
    <svg class="{{ icon_class }}" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
