{% for item in cart.items %}
          <li class="cart_popup_item" data-line="{{ forloop.index }}">
            <div class="product_line_wrapper">
            <div class="cart_popup_item_image">
              {{
                item.image
                | image_url: width: 100
                | image_tag:
                  alt: item.title,
                  class: 'cart-popup-item__image',
                  loading: 'lazy'
              }}
            </div>

            <div class="cart_popup_item_details">
              <h3 class="cart_popup_item_title">{{ item.title }}</h3>
              <p class="cart_popup_item_price">{{ item.price | money }}</p>

              <!-- QUANTITY CONTROLS -->
              <div
                class="cart_qty_control"
                data-line="{{ forloop.index }}"
              >
                <button
                  class="cart_qty_btn"
                  data-action="decrease"
                  type="button"
                >−</button>

                <span class="cart_qty_value">
                  {{ item.quantity }}
                </span>

                <button
                  class="cart_qty_btn"
                  data-action="increase"
                  type="button"
                >+</button>

              </div>
              <p class="cart_stock_error"></p>
            </div>
            </div>
            <div class="product_price_line_wrapper">
              <p class="cart_popup_item_total_price">
                {{ item.final_line_price | money }}
              </p>
            </div>
          </li>
        {% endfor %}