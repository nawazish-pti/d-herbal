<style>
    .drawer_toggle{
  background:none;
  border:none;
  cursor:pointer;
  display:none;
}

.mobile_drawer{
  position:fixed;
  top:0;
  left:0;
  width:100%;
  height:100%;
  background:rgba(0,0,0,.4);
  opacity:0;
  visibility:hidden;
  transition:.3s;
  z-index:9999;
}

.mobile_drawer.active{
  opacity:1;
  visibility:visible;
}

.mobile_drawer_inner{
  width:320px;
  max-width:90%;
  height:100%;
  background:#fff;
  padding:20px;
  transform:translateX(-100%);
  transition:.3s;
  overflow:auto;
}

.mobile_drawer.active .mobile_drawer_inner{
  transform:translateX(0);
}

.drawer_close{
  background:none;
  border:none;
  cursor:pointer;
  margin-left:auto;
  display:block;
}

.mobile_nav_list,
.mobile_submenu{
  list-style:none;
  padding:0;
  margin:0;
}

.mobile_nav_item{
  padding:12px 0;
  border-bottom:1px solid #eee;
}

.mobile_nav_item a,
.mobile_nav_item summary{
  text-decoration:none;
  color:#000;
  cursor:pointer;
  display:flex;
  justify-content:space-between;
}

.mobile_submenu{
  padding-left:15px;
  margin-top:10px;
}

.mobile_submenu li{
  padding:8px 0;
}

@media(max-width:989px){

  .drawer_toggle{
    display:block;
  }

  .header__menu{
    display:none;
  }
}
</style>
<button class="drawer_toggle">
  {% render 'svg-icons', icon: 'hamburger' %}
</button>

<div class="mobile_drawer">
  <div class="mobile_drawer_inner">

    <button class="drawer_close">
      {% render 'svg-icons', icon: 'cross' %}
    </button>

    <nav class="mobile_nav">
      <ul class="mobile_nav_list">
        {% for link in section.settings.main_menu.links %}
          <li class="mobile_nav_item">

            {% if link.links != blank %}
              
              <details>
                <summary>
                  {{ link.title }}
                </summary>

                <ul class="mobile_submenu">
                  {% for childlink in link.links %}
                    <li>
                      <a href="{{ childlink.url }}">
                        {{ childlink.title }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>

              </details>

            {% else %}

              <a href="{{ link.url }}">
                {{ link.title }}
              </a>

            {% endif %}

          </li>
        {% endfor %}
      </ul>
    </nav>

  </div>
</div>