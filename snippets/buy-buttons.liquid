{% assign current_variant = product.selected_or_first_available_variant %}

<product-form>
  {% form 'product', product %}
    <input
      type="hidden"
      name="id"
      value="{{ current_variant.id }}"
    >

    <button
      type="submit"
      name="add"
      class="add_to_cart_btn"
      {% unless current_variant.available %}
        disabled
      {% endunless %}
    >
      Add to Cart
    </button>

    {{ form | payment_button }}
  {% endform %}
</product-form>
