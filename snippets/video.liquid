{% comment %}
  Reusable Video Snippet

  Parameters:
  - video_url
  - video_file
  - poster
  - class
  - width
  - height
  - autoplay
  - loop
  - muted
  - controls
  - playsinline
  - preload
{% endcomment %}

{% assign video_class = class | default: '' %}
{% assign video_width = width | default: '100%' %}
{% assign video_height = height | default: 'auto' %}
{% assign video_preload = preload | default: 'metadata' %}

{% if video_file != blank %}

  {% comment %} {{
    video_file
    | video_tag:
      class: video_class,
      image_size: 'master',
      autoplay: autoplay,
      loop: loop,
      muted: muted,
      controls: controls,
      playsinline: playsinline,
      preload: video_preload
  }} {% endcomment %}
     <video
    class="{{ video_class }}"
    style="width: {{ video_width }}; height: {{ video_height }};"
    {% if poster != blank %}
      poster="{{ poster | image_url }}"
    {% endif %}
    {% if autoplay %}
      autoplay
    {% endif %}
    {% if loop %}
      loop
    {% endif %}
    {% if muted %}
      muted
    {% endif %}
    {% if controls %}
      controls
    {% endif %}
    {% if playsinline %}
      playsinline
    {% endif %}
    preload="{{ video_preload }}"
  >

    {% for source in video_file.sources %}
      <source
        src="{{ source.url }}"
        type="{{ source.mime_type }}"
      >
    {% endfor %}

  </video>


{% elsif video_url != blank %}

  <video
    class="{{ video_class }}"
    style="width: {{ video_width }}; height: {{ video_height }};"
    {% if poster != blank %}
      poster="{{ poster | image_url }}"
    {% endif %}
    {% if autoplay %}
      autoplay
    {% endif %}
    {% if loop %}
      loop
    {% endif %}
    {% if muted %}
      muted
    {% endif %}
    {% if controls %}
      controls
    {% endif %}
    {% if playsinline %}
      playsinline
    {% endif %}
    preload="{{ video_preload }}"
  >
    <source src="{{ video_url }}">
  </video>

{% endif %}