{% render 'button-styles', block_settings: block.settings, block_id: id %}

<div class="newsletter-block__container" id="Newsletter-{{ id }}" style="--newsletter-border-thickness: {{ block.settings.border_thickness | default: 1 }}px; --newsletter-border-color: {{ block.settings.border_color | default: 'rgba(255, 255, 255, 0.7)' }}; --newsletter-border-radius: {{ block.settings.border_radius | default: 0 }}px; --newsletter-input-bg-color: {{ block.settings.input_bg_color | default: 'transparent' }}; --newsletter-input-text-color: {{ block.settings.input_text_color | default: 'inherit' }}; --newsletter-placeholder-color: {{ block.settings.placeholder_color | default: 'inherit' }};">
  {%- if block.settings.heading != blank -%}
    <h2 class="newsletter-block__heading">{{ block.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- if block.settings.subtext != blank -%}
    <div class="newsletter-block__details-content rte newsletter-block__details-content--newsletter">
      {{ block.settings.subtext }}
    </div>
  {%- endif -%}
  {%- form 'customer', id: 'Contactnewsletter', class: 'newsletter__block-form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="newsletter-form__field-wrapper">
      <div class="field">
        <input
          id="NewsletterForm--{{ id }}"
          type="email"
          name="contact[email]"
          class="field__input"
          value="{{ form.email }}"
          aria-required="true"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          {% if form.errors %}
            autofocus
            aria-invalid="true"
            aria-describedby="Contactnewsletter-error"
          {% elsif form.posted_successfully? %}
            aria-describedby="Contactnewsletter-success"
          {% endif %}
          placeholder="{{ block.settings.placeholder }}"
          required
        >
        
        <button
          type="submit"
          class="
            newsletter-form__button
            buttons
            buttons--{{ id }}
            button_type_{{ block.settings.btn_type }}
            button_type_{{ block.settings.btn_type }}--{{ id }}
          "
          name="commit"
          id="Subscribe"
          aria-label="Subscribe"
        >
          {{ block.settings.button_label }}
        </button>
      </div>
      {%- if form.errors -%}
        <small class="newsletter-form__message form__message" id="Contactnewsletter-error">
          {{ form.errors.translated_fields.email | capitalize }}
          {{ form.errors.messages.email }}
        </small>
      {%- endif -%}
    </div>
    {%- if form.posted_successfully? -%}
      <h3
        class="newsletter-form__message newsletter-form__message--success form__message"
        id="Contactnewsletter-success"
        tabindex="-1"
        autofocus
      >
        {{ block.settings.success_message }}
      </h3>
    {%- endif -%}
  {%- endform -%}
</div>
