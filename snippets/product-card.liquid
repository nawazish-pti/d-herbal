{%- doc -%}
  This snippet is used to render a product card.
  It is used in the product block, featured product block, and the product card block.
  The product object is null or when placeholders are rendered.

  @param {object} product - The product object
  @param {object} children - The children of the product card
  @param {object} [block] - The block object
  @param {boolean} [has_secondary] - Whether the product has a secondary image for hover state
  @param {string} [media_block_output] - The rendered output of the media block 
{%- enddoc -%}

<div class="product-card-wrapper" {{ block.shopify_attributes }}>
  <div class="images_wrapper {% if has_secondary %}has-secondary{% endif %}" data-media-product-id="{{ product.id }}">
    {{ media_block_output }}
  </div>
  <div class="product-card__content" style="display: grid; gap: {{ block.settings.content_gap | default: 16 }}px;">
    {{ children }}
  </div>
</div>
