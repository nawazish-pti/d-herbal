{% liquid
  assign img_ratio = img_ratio | default: 'adapt'
  assign hover_secondary = hover_secondary | default: false
  assign img_w = 800
  assign img_h = ''

  if img_ratio == 'square'
    assign img_h = img_w
  elsif img_ratio == 'landscape'
    assign img_h = img_w | times: 9 | divided_by: 16
  elsif img_ratio == 'portrait'
    assign img_h = img_w | times: 4 | divided_by: 3
  endif
%}

<div class="product-card-wrapper">
  <div class="images_wrapper image--{{ img_ratio }} {% if hover_secondary %}has-secondary{% endif %}">
    {% if img_h != '' %}
      {% render 'image', image: product.featured_image, class: 'product-image primary', width: img_w, height: img_h, crop: 'center' %}
    {% else %}
      {% render 'image', image: product.featured_image, class: 'product-image primary', width: img_w %}
    {% endif %}
    {% if hover_secondary and product.images.size > 1 %}
      {% assign second_image = product.images[1] %}
      {% if img_h != '' %}
        {% render 'image', image: second_image, class: 'product-image secondary', width: img_w, height: img_h, crop: 'center' %}
      {% else %}
        {% render 'image', image: second_image, class: 'product-image secondary', width: img_w %}
      {% endif %}
    {% endif %}
  </div>
  <div class="product-card__content">
    <h3 class="product-card__title">{{ product.title }}</h3>
    <p class="product-card__price">
      <span class="main_price">{{ product.price | money }}</span>
      <span class="compare_price">{{ product.compare_at_price | money }}</span>
    </p>
    <div class="buy_btns">
        <div class="add_to_cart">
            <form method="post" action="{{routes.cart_add_url}}">
                <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                <button type="submit" class="product-card__btn"> Add to Cart </button>
            </form>
        </div>
        <div class="but_btn">
        </div>
    </div>
  </div>
</div>
