<div class="product-card-wrapper" {{ block.shopify_attributes }}>
  <div class="images_wrapper image--{{ img_ratio }} {% if has_secondary %}has-secondary{% endif %}" data-media-image-ratio="{{ img_ratio }}" data-media-img-w="{{ img_w }}" data-media-img-h="{{ img_h }}" data-media-product-id="{{ product.id }}">
    {{ media_block_output }}
  </div>

  <div class="product-card__content">
    {{ children }}
  </div>
</div>
