{% comment %}
  Renders an image block with full configurability.
  This is a wrapper around the main image snippet specifically for use within blocks.
  
  @param {object} settings - Block or section settings object
  @param {string} [prefix] - Optional settings prefix (e.g., 'banner_' for settings.banner_image)
  @param {object} [shopify_attributes] - Optional block shopify_attributes for editor support
{% endcomment %}

{%- liquid
  assign prefix = prefix | default: ''
  
  # Build setting keys with prefix
  assign image_key = prefix | append: 'image'
  assign mobile_image_key = prefix | append: 'mobile_image'
  assign link_key = prefix | append: 'link'
  assign alt_key = prefix | append: 'alt'
  assign aspect_ratio_key = prefix | append: 'aspect_ratio'
  assign object_fit_key = prefix | append: 'object_fit'
  assign hover_effect_key = prefix | append: 'hover_effect'
  assign loading_key = prefix | append: 'loading'
  assign overlay_color_key = prefix | append: 'overlay_color'
  assign overlay_opacity_key = prefix | append: 'overlay_opacity'
  
  # Get values from settings
  assign image = settings[image_key]
  assign mobile_image = settings[mobile_image_key]
  assign link = settings[link_key]
  assign alt = settings[alt_key]
  assign aspect_ratio = settings[aspect_ratio_key]
  assign object_fit = settings[object_fit_key]
  assign hover_effect = settings[hover_effect_key]
  assign loading = settings[loading_key]
  assign overlay_color = settings[overlay_color_key]
  assign overlay_opacity = settings[overlay_opacity_key]
-%}

<div class="block-image" {% if shopify_attributes %}{{ shopify_attributes }}{% endif %}>
  {% render 'image',
    image: image,
    mobile_image: mobile_image,
    url: link,
    aspect_ratio: aspect_ratio,
    object_fit: object_fit,
    hover_effect: hover_effect,
    loading: loading,
    alt: alt,
    overlay_color: overlay_color,
    overlay_opacity: overlay_opacity,
    class: 'block-image__img'
  %}
</div>

{% stylesheet %}
  .block-image {
    width: 100%;
    display: block;
  }
  
  .block-image__img {
    width: 100%;
    height: auto;
  }
{% endstylesheet %}
