<script src="{{ 'cart-popup.js' | asset_url }}" defer></script>
<div class="cart_main_popup_container">
  <div class="cart_popup_header">
    <h2>Your Cart</h2>
    <button class="close_cart_popup_btn">&times;</button>
  </div>

  <div class="cart_popup_items">
    {% if cart.item_count == 0 %}
      <p>Your cart is currently empty.</p>
    {% else %}
      <ul>
        {% if cart.item_count > 0 %}
          {% assign last_item = cart.items.first %}

          <li
            class="cart_popup_item"
            data-key="{{ last_item.key }}"
          >
            <div class="cart_popup_item_image">
              {{
                last_item.image
                | image_url: width: 120
                | image_tag: alt: last_item.title, class: 'cart-popup-item__image', loading: 'lazy'
              }}
            </div>

            <div class="cart_popup_item_details">
              <h3 class="cart_popup_item_title">
                {{ last_item.title }}
              </h3>

              <p class="cart_popup_added_text">Added to cart successfully</p>
            </div>
          </li>

          <!-- CART ACTION BUTTONS -->

          <div class="cart_popup_actions">
            <a
              href="{{ routes.cart_url }}"
              class="cart_popup_view_cart_btn"
            >
              View Cart ({{ cart.item_count }})
            </a>

            <a
              href="/checkout"
              class="cart_popup_checkout_btn"
            >
              Checkout
            </a>
          </div>

        {% else %}
          <p>Your cart is currently empty.</p>
        {% endif %}
      </ul>
    {% endif %}
  </div>
</div>
<style>
    .cart_qty_control {
    display: inline-flex;
    align-items: center;
    margin-top: 8px;
    border: 1px solid #ddd;
    border-radius: 6px;
    overflow: hidden;
    }

    .cart_qty_btn {
    width: 32px;
    height: 32px;
    border: none;
    background: #f7f7f7;
    cursor: pointer;
    font-size: 18px;
    line-height: 1;
    }

    .cart_qty_btn:hover {
    background: #eaeaea;
    }

    .cart_qty_value {
    min-width: 36px;
    text-align: center;
    font-size: 14px;
    }
    .cart_popup_actions {
      display: flex;
      flex-direction: column;
      /* justify-content: center; */
      align-items: center;
      gap: 10px;
      margin-top:10px;
  }
  a.cart_popup_view_cart_btn {
      padding: 13px 20px;
      border: 1px solid black;
      width: 100%;
      text-align: center;
      color: black;
      text-decoration: none;
      font-size: 16px;
  }
  a.cart_popup_view_cart_btn:hover{
    color:blue;
    border:2px solid black;
  }
  a.cart_popup_checkout_btn {
    padding: 13px 20px;
    border: 1px solid black;
    width: 100%;
    text-align: center;
    text-decoration: none;
    font-size: 16px;
    background: black;
    color: white;
}
</style>
