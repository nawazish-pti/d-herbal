<script src="{{ 'cart-popup.js' | asset_url }}" defer></script>
<div class="cart_main_popup_container">
  <div class="cart_popup_header">
    <h2>Your Cart</h2>
    <button class="close_cart_popup_btn">&times;</button>
  </div>

  <div class="cart_popup_items">
    {% if cart.item_count == 0 %}
      <p>Your cart is currently empty.</p>
    {% else %}
      <ul>
        {% render 'cart-items' %}
        
      </ul>
    {% endif %}
  </div>
</div>
<style>
    .cart_qty_control {
    display: inline-flex;
    align-items: center;
    margin-top: 8px;
    border: 1px solid #ddd;
    border-radius: 6px;
    overflow: hidden;
    }

    .cart_qty_btn {
    width: 32px;
    height: 32px;
    border: none;
    background: #f7f7f7;
    cursor: pointer;
    font-size: 18px;
    line-height: 1;
    }

    .cart_qty_btn:hover {
    background: #eaeaea;
    }

    .cart_qty_value {
    min-width: 36px;
    text-align: center;
    font-size: 14px;
    }

</style>