{% assign image_ratio = block.settings.image_ratio | default: 'adapt' %}
{% assign show_secondary = block.settings.show_secondary | default: false %}
{% assign img_w = 800 %}
{% assign has_secondary = false %}

{% if show_secondary and product.images.size > 1 %}
  {% assign has_secondary = true %}
{% endif %}

<div class="images_wrapper image--{{ image_ratio }} {% if has_secondary %}has-secondary{% endif %}">
  {% render 'image', image: product.featured_image, class: 'product-image primary', width: img_w %}

  {% if has_secondary %}
    {% assign second_image = product.images[1] %}
    {% render 'image', image: second_image, class: 'product-image secondary', width: img_w %}
  {% endif %}
</div>
